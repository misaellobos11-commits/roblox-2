		<Item class="ModuleScript" referent="RBX_ML_Economy_8_0_Direct"><Properties><string name="Name">Economy</string><ProtectedString name="Source">--!nonstrict
-- Matterloom 8.0: economía ficticia de créditos; reglas públicas también usadas por el cliente.
local E={}
E.startCash=700
E.unlockThresholds={0,180,650,1800,4000}
E.levelNames={'Inicio','Procesamiento','Síntesis','Industria','Tecnología avanzada'}
E.prices={
    Receiver=200, Belt=10, CarbonProcessor=125, Seller=100,
    Storage=160, OxygenProcessor=170, SplitterLeft=55, SplitterRight=55,
    FilterLeft=85, FilterRight=85,
    SiliconProcessor=210, CopperProcessor=220, HydrogenProcessor=220,
    FusionChamber=450, SplitterThree=95, OverflowLeft=80, OverflowRight=80,
    IronProcessor=250, ElementSynthesizer=600, Crystallizer=500,
    ElevatorUp=150, ElevatorDown=150,
    MineralFormer=650, Smelter=720,
}
E.tiers={
    Receiver=1, Belt=1, CarbonProcessor=1, Seller=1,
    Storage=2, OxygenProcessor=2, SplitterLeft=2, SplitterRight=2, FilterLeft=2, FilterRight=2,
    SiliconProcessor=3, CopperProcessor=3, HydrogenProcessor=3,
    FusionChamber=3, SplitterThree=3, OverflowLeft=3, OverflowRight=3,
    IronProcessor=4, ElementSynthesizer=4, Crystallizer=4, ElevatorUp=4, ElevatorDown=4,
    MineralFormer=5, Smelter=5,
}
function E.tier(revenue)
    local tier=1
    for i=2,#E.unlockThresholds do
        if (revenue or 0)&gt;=E.unlockThresholds[i] then tier=i end
    end
    return tier
end
function E.unlocked(machineType,revenue)
    return (E.tiers[machineType] or math.huge)&lt;=E.tier(revenue)
end
function E.price(machineType)
    return E.prices[machineType]
end
function E.nextThreshold(revenue)
    local tier=E.tier(revenue)
    return E.unlockThresholds[tier+1]
end
return table.freeze(E)
</ProtectedString></Properties></Item></Item>
