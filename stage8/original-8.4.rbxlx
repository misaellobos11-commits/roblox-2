					<ProtectedString name="Source">--!nonstrict
-- Modelos 3D generados solamente con Parts de Roblox, sin Toolbox.
local TweenService=game:GetService('TweenService')
local Construction=require(script.Parent.Construction)
local Catalog=require(script.Parent.MachineCatalog)
local Visual={}
local dark=Color3.fromRGB(35,48,60)
local steel=Color3.fromRGB(91,109,125)
local cyan=Color3.fromRGB(69,224,230)
local orange=Color3.fromRGB(250,181,91)
local function block(parent,name,size,pos,color,material)
    local p=Instance.new('Part')
    p.Name=name
    p.Size=size
    p.CFrame=CFrame.new(pos)
    p.Anchored=true
    p.Material=material or Enum.Material.Metal
    p.Color=color
    p.TopSurface=Enum.SurfaceType.Smooth
    p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function label(parent,name,title,height)
    local billboard=Instance.new('BillboardGui')
    billboard.Name=name
    billboard.AlwaysOnTop=true
    billboard.Size=UDim2.fromOffset(170,34)
    billboard.StudsOffsetWorldSpace=Vector3.new(0,height,0)
    billboard.MaxDistance=85
    billboard.Parent=parent
    local t=Instance.new('TextLabel')
    t.Name='Text'
    t.Size=UDim2.fromScale(1,1)
    t.BackgroundColor3=Color3.fromRGB(20,31,40)
    t.BackgroundTransparency=.15
    t.TextColor3=Color3.fromRGB(223,242,250)
    t.Font=Enum.Font.GothamBold
    t.TextSize=12
    t.Text=title
    t.Parent=billboard
    local corner=Instance.new('UICorner')
    corner.CornerRadius=UDim.new(0,7)
    corner.Parent=t
    return t
end
-- MATTERLOOM 6.0: imported Blender GLB visual assets (fallback to the old procedural models).
-- Import all GLBs to Roblox Studio, then use Instalar_Modelos_CommandBar.lua once.
-- Template folder is replicated to clients for BuildPreview; no asset IDs hard-coded.
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local visualKeys={
    Receiver='MatterReceiver_v1',
    CarbonProcessor='CarbonProcessor_v1',
    OxygenProcessor='OxygenProcessor_v1',
    SiliconProcessor='SiliconProcessor_v1',
    IronProcessor='IronProcessor_v1',
    CopperProcessor='CopperProcessor_v1',
    HydrogenProcessor='HydrogenProcessor_v1',
    FusionChamber='FusionChamber_v3',
    ElementSynthesizer='ElementSynthesizer_v2',
    Crystallizer='Crystallizer_v1',
    MineralFormer='MineralFormer_v1',
    Smelter='Smelter_v2',
    Storage='Storage_v1',
    Seller='Seller_v1',
    Belt='Belt_Straight_v2',
    ElevatorUp='Elevator_Up_v1',
    ElevatorDown='Elevator_Down_v1',
    SplitterLeft='Splitter_Left_v4',
    SplitterRight='Splitter_Right_v4',
    SplitterThree='Splitter_ThreeWay_v4',
    OverflowLeft='Overflow_Left_v4',
    OverflowRight='Overflow_Right_v4',
    FilterLeft='Filter_Left_v4',
    FilterRight='Filter_Right_v4',
}
local function assetFolder()
    return ReplicatedStorage:FindFirstChild('MatterloomVisualAssets')
end
local function installBlenderAsset(wrapper,key)
    local folder=assetFolder()
    local template=folder and folder:FindFirstChild(key)
    if not template or not template:IsA('Model') then return false end
    local imported=template:Clone()
    imported.Name='VisualBlender'
    local hasPart=false
    for _,desc in ipairs(imported:GetDescendants()) do
        if desc:IsA('BasePart') then
            hasPart=true
            desc.Anchored=true
            desc.CanCollide=false
            desc.CanTouch=false
            desc.CanQuery=false
            desc.CastShadow=false
        end
    end
    if not hasPart then imported:Destroy(); return false end
    -- Reset world placement from Studio import; center the bottom at our logical pivot.
    -- If a particular mesh cannot be scaled, fall back without breaking construction.
    local ok,err=pcall(function()
        imported:PivotTo(CFrame.identity)
        local bounds,dim=imported:GetBoundingBox()
        assert(math.max(dim.X,dim.Z)&gt;0.01, 'Dimensiones GLB inválidas')
        local size=Catalog.types[wrapper:GetAttribute('MachineType')].size*Construction.CELL_SIZE
        local scale=(size-.10)/math.max(dim.X,dim.Z)
        imported:ScaleTo(scale)
        bounds,dim=imported:GetBoundingBox()
        local bottom=bounds.Position.Y-dim.Y/2
        local offset=CFrame.new(-bounds.Position.X,-bottom,-bounds.Position.Z)
        imported:PivotTo(offset*imported:GetPivot())
        imported:PivotTo(wrapper.PrimaryPart.CFrame*imported:GetPivot())
        imported.Parent=wrapper
    end)
    if not ok then
        warn('Matterloom: error al montar malla '..key..': '..tostring(err))
        imported:Destroy()
        return false
    end
    wrapper:SetAttribute('ImportedVisual',true)
    wrapper:SetAttribute('VisualAssetKey',key)
    return true
end
local function importedLabel(model,record,anchor)
    if record.machineType=='Belt' then return end
    local data=Catalog.types[record.machineType]
    local height=if Catalog.isElevator(record.machineType) then 10
        elseif Catalog.isTransport(record.machineType) then 3.4
        elseif record.machineType=='Seller' then 8 else 7.3
    label(anchor,'Etiqueta',data.name:upper(),height)
end
local function changeBeltAsset(model,newKey)
    local existing=model:FindFirstChild('VisualBlender')
    if model:GetAttribute('VisualAssetKey')==newKey then return true end
    -- Keep current mesh if the optional curve variant has not been imported.
    local folder=assetFolder()
    if not (folder and folder:FindFirstChild(newKey)) then return false end
    local oldKey=model:GetAttribute('VisualAssetKey')
    if existing then existing:Destroy() end
    if installBlenderAsset(model,newKey) then return true end
    if oldKey then installBlenderAsset(model,oldKey) end
    return false
end

function Visual.pivot(model,record,origin)
    local size=Catalog.types[record.machineType].size
    local center=origin+Vector3.new((record.x+size/2)*Construction.CELL_SIZE,(record.level or 0)*8,(record.z+size/2)*Construction.CELL_SIZE)
    model:PivotTo(CFrame.new(center)*CFrame.Angles(0,-record.rotation*math.pi/2,0))
    model:SetAttribute('GridX',record.x)
    model:SetAttribute('GridZ',record.z)
    model:SetAttribute('Rotation',record.rotation)
    model:SetAttribute('Level',record.level or 0)
end
-- A belt has ONE exit (its visible arrow), but three possible entries.
-- Incoming vector is the world flow vector of the connected source.
-- The path bends toward the exit when the previous conveyor points sideways.
function Visual.setBeltIncoming(model,incoming)
    if not model or model:GetAttribute('MachineType')~='Belt' then return end
    local root=model.PrimaryPart
    if not root then return end
    local entryX,entryZ=0,-1
    if incoming then
        local localFlow=root.CFrame:VectorToObjectSpace(Vector3.new(incoming.dx,0,incoming.dz))
        if math.abs(localFlow.X)&gt;.5 then
            entryX=if localFlow.X&gt;0 then -1 else 1
            entryZ=0
        end
    end
    -- La malla curva cambia según el lado por donde entra el producto.
    -- El recorrido real de la materia sigue siendo autoritativo en el servidor.
    if model:GetAttribute('ImportedVisual') then
        local wanted=if entryX==0 then 'Belt_Straight_v2'
            elseif entryX&lt;0 then 'Belt_Curve_Right_v2'
            else 'Belt_Curve_v2'
        changeBeltAsset(model,wanted)
        model:SetAttribute('IsCorner',entryX~=0)
        model:SetAttribute('CornerFromX',entryX)
        return
    end
    local old=model:FindFirstChild('RutaCinta')
    if old and model:GetAttribute('CornerFromX')==entryX then return end
    if old then old:Destroy() end
    local folder=Instance.new('Folder')
    folder.Name='RutaCinta'
    folder.Parent=model
    local paint=Color3.fromRGB(245,186,68)
    local track=Color3.fromRGB(147,116,53)
    local function line(a,b,width,color)
        local worldA=root.CFrame:PointToWorldSpace(a)
        local worldB=root.CFrame:PointToWorldSpace(b)
        local distance=(worldB-worldA).Magnitude
        if distance&lt;.001 then return end
        local part=block(folder,'TrazoCinta',Vector3.new(width,.045,distance),Vector3.zero,color,Enum.Material.SmoothPlastic)
        part.CFrame=CFrame.lookAt((worldA+worldB)*.5,worldB)
        part.CanCollide=false
        part.CanQuery=false
        part.CanTouch=false
        return part
    end
    -- Pequeños cheurones repetidos, sin una flecha grande o brillo fuerte.
    -- (dx,dz) siempre representa la dirección REAL del producto.
    local function arrow(x,z,dx,dz)
        local center=Vector3.new(x,.83,z)
        local dir=Vector3.new(dx,0,dz)
        local side=Vector3.new(-dz,0,dx)
        local tip=center+dir*.20
        line(center-dir*.19,tip,.10,paint)
        line(tip,tip-dir*.21+side*.18,.115,paint)
        line(tip,tip-dir*.21-side*.18,.115,paint)
    end
    if entryX==0 then
        line(Vector3.new(0,.805,-1.55),Vector3.new(0,.805,1.55),.09,track)
        for _,z in {-1.18,-.40,.38,1.16} do arrow(0,z,0,1) end
    else
        line(Vector3.new(entryX*1.5,.805,0),Vector3.new(0,.805,0),.09,track)
        line(Vector3.new(0,.805,0),Vector3.new(0,.805,1.55),.09,track)
        arrow(entryX*1.16,0,-entryX,0)
        arrow(entryX*.51,0,-entryX,0)
        arrow(0,.50,0,1)
        arrow(0,1.16,0,1)
    end
    -- El puerto de entrada no ocupa el ancho completo de la cinta.
    local inlet=block(folder,'EntradaCompacta',
        if entryX==0 then Vector3.new(.72,.09,.16) else Vector3.new(.16,.09,.72),
        Vector3.zero,Color3.fromRGB(202,146,67),Enum.Material.SmoothPlastic)
    inlet.CFrame=root.CFrame*CFrame.new(entryX*1.80,.64,entryZ*1.80)
    inlet.CanCollide=false;inlet.CanQuery=false;inlet.CanTouch=false
    model:SetAttribute('IsCorner',entryX~=0)
    model:SetAttribute('CornerFromX',entryX)
end

-- ETAPA 5: Aspecto modular industrial-futurista creado 100% con Parts.
-- Todas las decoraciones respetan el perímetro físico de cada pieza y sus puertos.
local graphite=Color3.fromRGB(26,34,44)
local graphite2=Color3.fromRGB(41,52,65)
local metal=Color3.fromRGB(85,102,119)
local silver=Color3.fromRGB(153,169,180)
local gold=Color3.fromRGB(245,185,65)
local goldDark=Color3.fromRGB(150,105,43)
local plasma=Color3.fromRGB(114,230,255)
local fusionOrange=Color3.fromRGB(255,118,46)
local violet=Color3.fromRGB(178,103,255)
local lime=Color3.fromRGB(83,237,142)
local function detail(parent,name,size,pos,color,material)
    local item=block(parent,name,size,pos,color,material or Enum.Material.Metal)
    item.CanCollide=false
    item.CanTouch=false
    item.CanQuery=false
    item.CastShadow=false
    return item
end
local function glass(parent,name,size,pos,color,transparency)
    local p=detail(parent,name,size,pos,color,Enum.Material.Glass)
    p.Transparency=transparency or .28
    return p
end
local function glow(parent,name,size,pos,color)
    return detail(parent,name,size,pos,color,Enum.Material.Neon)
end
local function cylinder(parent,name,position,height,diameter,color,material,axis)
    local p=detail(parent,name,Vector3.new(height,diameter,diameter),position,color,material or Enum.Material.Metal)
    p.Shape=Enum.PartType.Cylinder
    if axis~='X' then
        if axis=='Z' then p.CFrame=p.CFrame*CFrame.Angles(0,math.pi/2,0)
        else p.CFrame=p.CFrame*CFrame.Angles(0,0,math.pi/2) end
    end
    return p
end
local function sphere(parent,name,position,diameter,color,material)
    local p=detail(parent,name,Vector3.new(diameter,diameter,diameter),position,color,material or Enum.Material.Glass)
    p.Shape=Enum.PartType.Ball
    return p
end
local function rod(parent,name,from,to,thickness,color,material)
    local a=Vector3.new(from[1],from[2],from[3])
    local b=Vector3.new(to[1],to[2],to[3])
    local d=(b-a).Magnitude
    local p=detail(parent,name,Vector3.new(thickness,thickness,d),(a+b)*.5,color,material)
    p.CFrame=CFrame.lookAt((a+b)*.5,b)
    return p
end
local function plateBevel(model,half,accent)
    -- Perfil industrial común en todas las máquinas de 2 x 2.
    detail(model,'PlataformaBlindada',Vector3.new(half*2-.55,.65,half*2-.55),Vector3.new(0,.58,0),graphite2)
    for _,x in {-half+.33,half-.33} do
        detail(model,'RaílLongitudinal',Vector3.new(.18,.20,half*2-.75),Vector3.new(x,1,0),silver)
        glow(model,'LuzArista',Vector3.new(.11,.10,2.1),Vector3.new(x,1.13,0),accent)
    end
    for _,z in {-half+.33,half-.33} do
        detail(model,'RaílTransversal',Vector3.new(half*2-.75,.20,.18),Vector3.new(0,1,z),silver)
    end
    for _,x in {-half+.65,half-.65} do
        for _,z in {-half+.65,half-.65} do
            detail(model,'BloqueEsquina',Vector3.new(.63,.8,.63),Vector3.new(x,1.25,z),graphite)
            glow(model,'MarcadorEsquina',Vector3.new(.28,.08,.28),Vector3.new(x,1.68,z),accent)
        end
    end
end
local function cornerColumn(model,x,z,y,height)
    detail(model,'Columna',Vector3.new(.65,height,.65),Vector3.new(x,y,z),metal)
    detail(model,'TopeColumna',Vector3.new(.82,.22,.82),Vector3.new(x,y+height/2,z),silver)
end
local function frame(model,baseY,roofY,accent)
    for _,x in {-2.65,2.65} do
        for _,z in {-2.45,2.45} do
            cornerColumn(model,x,z,(baseY+roofY)/2,roofY-baseY)
        end
    end
    detail(model,'TechoIndustrial',Vector3.new(6.45,.42,6.05),Vector3.new(0,roofY+.16,0),graphite)
    glow(model,'BandaEstado',Vector3.new(3.4,.13,.20),Vector3.new(0,roofY+.42,-2.95),accent)
end
local function vents(model,x,y,z,color)
    for _,i in {-1,0,1} do
        detail(model,'Rejilla',Vector3.new(.11,.14,.51),Vector3.new(x+i*.27,y,z),color or silver)
    end
end
local function makePorts(model,rec)
    local two=Catalog.dualInput(rec)
    if rec.machineType~='Receiver' then
        if two then
            -- Coincide con Catalog.inputPorts: lados X + / -, Z local +2 studs.
            for _,sign in {-1,1} do
                detail(model,'BandejaEntrada',Vector3.new(.95,.22,2.05),Vector3.new(sign*3.37,.78,1.85),graphite)
                glow(model,'EntradaNaranja',Vector3.new(.18,.20,1.14),Vector3.new(sign*3.89,.90,1.85),fusionOrange)
                glow(model,'MarcaEntrada',Vector3.new(.33,.13,.22),Vector3.new(sign*3.68,1.08,1.85),gold)
            end
        else
            detail(model,'BandejaEntrada',Vector3.new(2.5,.22,.85),Vector3.new(0,.79,-3.32),graphite)
            glow(model,'EntradaNaranja',Vector3.new(2.1,.20,.14),Vector3.new(0,.9,-3.91),fusionOrange)
        end
    end
    if rec.machineType~='Seller' then
        detail(model,'BandejaSalida',Vector3.new(2.55,.21,.88),Vector3.new(0,.78,3.30),graphite)
        glow(model,'SalidaCian',Vector3.new(2.18,.20,.14),Vector3.new(0,.90,3.91),plasma)
    end
end
local function styleTransport(model,rec,data,anchor)
    local t=rec.machineType
    -- 1x1 = 4x4 studs. Flechas pequeñas, repetidas y sin brillo excesivo.
    detail(model,'LechoCinta',Vector3.new(3.50,.21,3.50),Vector3.new(0,.60,0),graphite,Enum.Material.SmoothPlastic)
    for _,x in {-1.76,1.76} do
        detail(model,'BordeCinta',Vector3.new(.17,.38,3.72),Vector3.new(x,.82,0),metal)
        glow(model,'CarrilAmbar',Vector3.new(.10,.08,3.38),Vector3.new(x,.99,0),goldDark)
        for _,z in {-1.3,1.3} do
            glow(model,'PilotoCinta',Vector3.new(.14,.13,.20),Vector3.new(x,.97,z),gold)
        end
    end
    if t=='Belt' then
        -- Ruta con cheurones dinámicos creada por Visual.setBeltIncoming.
        detail(model,'Cinta',Vector3.new(3.23,.11,3.17),Vector3.new(0,.72,0),Color3.fromRGB(31,41,53),Enum.Material.SmoothPlastic)
        for _,z in {-1.36,1.36} do
            cylinder(model,'Rodillo',Vector3.new(0,.80,z),2.75,.32,Color3.fromRGB(110,118,130),Enum.Material.Metal,'X')
        end
        return
    end
    local isElevator=(t=='ElevatorUp' or t=='ElevatorDown')
    if isElevator then
        local light=if t=='ElevatorUp' then Color3.fromRGB(72,218,255) else Color3.fromRGB(122,155,250)
        detail(model,'TorreAscensor',Vector3.new(2.85,7.2,2.85),Vector3.new(0,4.2,0),graphite2)
        for _,x in {-1.34,1.34} do
            detail(model,'SoporteVertical',Vector3.new(.30,7.85,.35),Vector3.new(x,4.23,-1.26),silver)
            glow(model,'TiraAscensor',Vector3.new(.12,6.95,.1),Vector3.new(x,4.2,-1.48),light)
        end
        for _,y in {1.7,3.6,5.5,7.4} do
            local p=detail(model,'FlechaVertical',Vector3.new(1.30,.18,.16),Vector3.new(0,y,-1.50),light)
            local arrow=glow(model,'PuntaAscensor',Vector3.new(.65,.14,.16),Vector3.new(0,y+(if t=='ElevatorUp' then .33 else -.33),-1.51),light)
            arrow.CFrame=arrow.CFrame*CFrame.Angles(0,0,if t=='ElevatorUp' then math.rad(35) else math.rad(-35))
        end
        detail(model,'AcopleSuperior',Vector3.new(3.65,.31,3.65),Vector3.new(0,8.12,0),metal)
        glow(model,'SalidaElevada',Vector3.new(2.35,.13,.28),Vector3.new(0,8.35,1.45),light)
        label(anchor,'Etiqueta',data.name:upper(),10.1)
        return
    end
    -- Distribuidores de transporte: hub central con flechas en múltiples rutas.
    detail(model,'NúcleoDistribuidor',Vector3.new(2.9,.18,2.8),Vector3.new(0,.79,0),graphite2)
    glow(model,'IndicadorCentral',Vector3.new(1.02,.07,1.02),Vector3.new(0,.93,0),if Catalog.isFilter(t) then lime else goldDark)
    local function chevron(x,z,dx,dz,cc)
        local a=Vector3.new(x,.97,z)
        local d=Vector3.new(dx,0,dz)
        local side=Vector3.new(-dz,0,dx)
        local tip=a+d*.31
        rod(model,'Flecha', {tip.X,tip.Y,tip.Z},{(a-d*.19+side*.18).X,(a-d*.19+side*.18).Y,(a-d*.19+side*.18).Z},.11,cc,Enum.Material.SmoothPlastic)
        rod(model,'Flecha', {tip.X,tip.Y,tip.Z},{(a-d*.19-side*.18).X,(a-d*.19-side*.18).Y,(a-d*.19-side*.18).Z},.11,cc,Enum.Material.SmoothPlastic)
    end
    for _,z in {-1.2,-.45,.35,1.17} do chevron(0,z,0,1,gold) end
    local left=(t=='SplitterLeft' or t=='OverflowLeft' or t=='FilterLeft' or t=='SplitterThree')
    local right=(t=='SplitterRight' or t=='OverflowRight' or t=='FilterRight' or t=='SplitterThree')
    if left then
        chevron(-.93,0,-1,0,gold)
        glow(model,'SalidaLateral',Vector3.new(.14,.10,.86),Vector3.new(-1.86,.9,0),if Catalog.isFilter(t) then lime else gold)
    end
    if right then
        chevron(.93,0,1,0,gold)
        glow(model,'SalidaLateral',Vector3.new(.14,.10,.86),Vector3.new(1.86,.9,0),if Catalog.isFilter(t) then lime else gold)
    end
    if Catalog.isFilter(t) then
        detail(model,'Escáner',Vector3.new(1.25,.75,1.35),Vector3.new(0,1.90,0),graphite)
        glow(model,'PantallaFiltro',Vector3.new(.93,.18,.91),Vector3.new(0,2.31,0),lime)
        for _,x in {-1.05,1.05} do
            glow(model,'BarraSensores',Vector3.new(.15,.67,.16),Vector3.new(x,1.5,0),lime)
        end
    elseif t=='OverflowLeft' or t=='OverflowRight' then
        glow(model,'PrioridadFrente',Vector3.new(1.25,.14,.14),Vector3.new(0,1.65,1.42),gold)
        detail(model,'MarcadorPrioridad',Vector3.new(.52,.34,.50),Vector3.new(0,1.94,-.85),fusionOrange)
    elseif t=='SplitterThree' then
        detail(model,'CabezalTriple',Vector3.new(1.36,.40,1.36),Vector3.new(0,1.79,0),metal)
        glow(model,'DivisorActivo',Vector3.new(.60,.13,.63),Vector3.new(0,2.07,0),gold)
    end
    label(anchor,'Etiqueta',data.name:upper(),3.65)
end
local function styleProcessor(model,rec,data)
    local t=rec.machineType
    local accent=data.color
    -- Base común con carcasa menos voluminosa; deja a la vista cada mecanismo.
    plateBevel(model,4,accent)
    detail(model,'CarcasaPrincipal',Vector3.new(6.10,2.3,5.42),Vector3.new(0,2.15,-.20),graphite2)
    detail(model,'Cubierta',Vector3.new(6.35,.35,5.60),Vector3.new(0,3.48,-.20),metal)
    for _,x in {-2.85,2.85} do
        glow(model,'IndicadorDeFamilia',Vector3.new(.14,.62,2.10),Vector3.new(x,2.48,0),accent)
    end
    if t=='Receiver' then
        for _,x in {-2.3,2.3} do
            cornerColumn(model,x,0,4.75,3.05)
            glow(model,'Emisor',Vector3.new(.32,.30,.32),Vector3.new(x,6.51,0),plasma)
        end
        detail(model,'BaseNúcleo',Vector3.new(3.4,.65,3.4),Vector3.new(0,4.1,0),graphite)
        local core=glass(model,'Materia',Vector3.new(2.15,2.15,2.15),Vector3.new(0,5.75,0),plasma,.12)
        core.CFrame=core.CFrame*CFrame.Angles(0,math.pi/4,math.pi/7)
        glow(model,'NúcleoInterno',Vector3.new(1.10,1.10,1.10),Vector3.new(0,5.75,0),Color3.fromRGB(175,247,255))
    elseif t=='CarbonProcessor' then
        detail(model,'TolvaCarbono',Vector3.new(3.9,1.9,3.5),Vector3.new(-.2,4.35,0),graphite)
        for _,x in {-1.7,0,1.7} do
