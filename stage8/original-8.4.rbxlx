        {t='Seller',x=31,z=28,r=0,level=0},
        {t='Belt',x=30.5,z=25,r=1,level=0},
        {t='Belt',x=29.5,z=25,r=1,level=0},
        {t='Belt',x=28.5,z=25,r=0,level=0},
        {t='Belt',x=28.5,z=26,r=0,level=0},
        {t='Belt',x=28.5,z=27,r=0,level=0},
        {t='Seller',x=28,z=28,r=0,level=0},
        {t='Receiver',x=40,z=22,r=0,level=0},
        {t='Belt',x=40.5,z=24,r=0,level=0},
        {t='SplitterRight',x=40.5,z=25,r=0,level=0},
        {t='Belt',x=40.5,z=26,r=0,level=0},
        {t='Belt',x=40.5,z=27,r=0,level=0},
        {t='Seller',x=40,z=28,r=0,level=0},
        {t='Belt',x=41.5,z=25,r=3,level=0},
        {t='Belt',x=42.5,z=25,r=3,level=0},
        {t='Belt',x=43.5,z=25,r=0,level=0},
        {t='Belt',x=43.5,z=26,r=0,level=0},
        {t='Belt',x=43.5,z=27,r=0,level=0},
        {t='Seller',x=43,z=28,r=0,level=0}
    }
            local staged=Construction.fromSnapshot(Construction.snapshot(session.state))
            local valid=true
            local failedCode='occupied'
            for _,entry in ipairs(demo) do
                local ok,code=Construction.apply(staged,player.UserId,{
                    kind='place',machineType=entry.t,x=entry.x,z=entry.z,
                    rotation=entry.r,level=entry.level
                })
                if not ok then valid=false;failedCode=code;break end
            end
            if not valid then
                local response=packet(session)
                response.ok=false
                response.code=if failedCode=='limit' then 'limit' else 'demo_blocked'
                command:FireClient(player,response)
                return
            end
            for _,entry in ipairs(demo) do
                local ok,_,id=Construction.apply(session.state,player.UserId,{
                    kind='place',machineType=entry.t,x=entry.x,z=entry.z,
                    rotation=entry.r,level=entry.level
                })
                if ok then
                    if entry.filterItem then
                        Construction.apply(session.state,player.UserId,{kind='configure_filter',id=id,item=entry.filterItem})
                    end
                    if entry.blocked then
                        -- Almacén de demostración lleno: prueba inmediata de desbordamiento.
                        local full={input={},output={},last=0,alternate=false,totalMade=0,totalMoved=0,nextRoute=0}
                        for n=1,40 do table.insert(full.output,'RawMatter') end
                        session.runtime[id]=full
                    end
                    local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                    model:SetAttribute('OwnerUserId',player.UserId)
                    session.models[id]=model
                end
            end
            redrawBelts(session)
            -- Ocho carteles flotantes por zona; son decorativos, NO cuentan como máquinas.
            local labels={
                {'01  CLASIFICACIÓN',8,1},
                {'02  TRES VÍAS',19,1},
                {'03  DESBORDE IZQ. (BUFFER LLENO)',30,1},
                {'04  ASCENSORES 0 → 1 → 0',40,1},
                {'05  DIVISOR IZQUIERDO',8,20},
                {'06  DESBORDE DER. (BUFFER LLENO)',19,20},
                {'07  FILTRO IZQUIERDO',31,20},
                {'08  DIVISOR DERECHO',40,20},
            }
            if not session.machines:FindFirstChild('DemoLabels') then
                local folder=Instance.new('Folder')
                folder.Name='DemoLabels'
                folder.Parent=session.machines
                for _,entry in ipairs(labels) do
                    local anchor=Instance.new('Part')
                    anchor.Name='ZonaDemo'
                    anchor.Size=Vector3.new(.2,.2,.2)
                    anchor.Anchored=true;anchor.Transparency=1
                    anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
                    anchor.Position=session.origin+Vector3.new(entry[2]*Construction.CELL_SIZE,7,entry[3]*Construction.CELL_SIZE)
                    anchor.Parent=folder
                    local gui=Instance.new('BillboardGui')
                    gui.Size=UDim2.fromOffset(225,40)
                    gui.MaxDistance=140
                    gui.AlwaysOnTop=true
                    gui.Parent=anchor
                    local text=Instance.new('TextLabel')
                    text.Size=UDim2.fromScale(1,1)
                    text.BackgroundColor3=Color3.fromRGB(19,35,45)
                    text.TextColor3=Color3.fromRGB(87,228,230)
                    text.Font=Enum.Font.GothamBold
                    text.TextScaled=true
                    text.Text=entry[1]
                    text.Parent=gui
                end
            end
            local response=packet(session)
            response.ok=true
            response.code='demo'
            command:FireClient(player,response)
            factoryUpdate:FireClient(player,Simulation.report(session))
            return
        end

        -- Etapa 4: cuatro cadenas de síntesis, con recetas independientes.
        if order.kind=='demo_production' then
            local demo={
                {t='Receiver',x=2,z=3,r=3,level=0},
                {t='Belt',x=4,z=3.5,r=3,level=0},
                {t='CarbonProcessor',x=5,z=3,r=3,level=0},
