        {t='Seller',x=5,z=28,r=0,level=0},
        {t='Receiver',x=19,z=22,r=0,level=0},
        {t='Belt',x=19.5,z=24,r=0,level=0},
        {t='OverflowRight',x=19.5,z=25,r=0,level=0},
        {t='Belt',x=19.5,z=26,r=0,level=0},
        {t='Belt',x=19.5,z=27,r=0,level=0},
        {t='Storage',x=19,z=28,r=0,level=0,blocked=true},
        {t='Belt',x=20.5,z=25,r=3,level=0},
        {t='Belt',x=21.5,z=25,r=3,level=0},
