                {t='Belt',x=27.5,z=42,r=0,level=0},
                {t='Belt',x=27.5,z=43,r=0,level=0},
                {t='Belt',x=27.5,z=44,r=0,level=0},
                {t='Seller',x=27,z=45,r=0,level=0},
                {t='Receiver',x=42,z=34,r=0,level=0},
                {t='Belt',x=42.5,z=36,r=0,level=0},
                {t='ElevatorUp',x=42.5,z=37,r=0,level=0},
                {t='Belt',x=42.5,z=38,r=0,level=1},
                {t='Belt',x=42.5,z=39,r=0,level=1},
                {t='Belt',x=42.5,z=40,r=0,level=1},
                {t='Belt',x=42.5,z=41,r=0,level=1},
                {t='Belt',x=42.5,z=42,r=0,level=1},
                {t='ElevatorDown',x=42.5,z=43,r=0,level=0},
                {t='Belt',x=42.5,z=44,r=0,level=0},
                {t='Seller',x=42,z=45,r=0,level=0},
            }
            -- Etapa 1: validar todo en una copia, sin efectos secundarios.
            local staged=Construction.fromSnapshot(Construction.snapshot(session.state))
            local createdIds={}
            for _,entry in ipairs(demo) do
                local good,errorCode,newId=Construction.apply(staged,player.UserId,{
                    kind='place',machineType=entry.t,x=entry.x,z=entry.z,
                    rotation=entry.r,level=entry.level
                })
                if good then table.insert(createdIds,newId) end
                if not good then
                    local reply=packet(session)
                    reply.ok=false;reply.code='mega_blocked'
                    reply.detail=errorCode
                    command:FireClient(player,reply)
                    return
                end
            end
            -- Etapa 2: guardar toda la configuración antes de generar modelos 3D.
            session.state=staged
            local created={}
            for i,entry in ipairs(demo) do
                local record=session.state.buildings[createdIds[i]]
                -- Se reutilizan los IDs validados aunque el jugador haya borrado una fábrica anterior.
                if record then
                    if entry.recipeId then
                        Construction.apply(session.state,player.UserId,{
                            kind='configure_recipe',id=record.id,recipeId=entry.recipeId})
                    end
                    if entry.filterItem then
                        Construction.apply(session.state,player.UserId,{
                            kind='configure_filter',id=record.id,item=entry.filterItem})
                    end
                    if entry.blocked then
                        local full={input={},output={},last=0,alternate=false,totalMade=0,totalMoved=0,nextRoute=0}
                        for n=1,40 do table.insert(full.output,'RawMatter') end
                        session.runtime[record.id]=full
                    end
                    table.insert(created,record)
                end
            end
            for index,record in ipairs(created) do
                if index%20==0 then task.wait() end
                local model=Visual.create(session.machines,record,session.origin,false)
                model:SetAttribute('OwnerUserId',player.UserId)
                session.models[record.id]=model
            end
            redrawBelts(session)
            local labels={
                {'A / CARBONO + OXÍGENO',11,1},
                {'B / SILICATO + CRISTAL',34,1},
                {'C / MINERAL + LINGOTE',11,25},
                {'D / MEZCLA CONDUCTIVA',34,25},
                {'E / FILTRO DE CARBONO',5,12},
                {'F / TRES VÍAS + HIDRÓGENO',17,12},
                {'G / DESBORDE IZQUIERDO',29,12},
                {'H / DIVISOR + ALMACÉN',41,12},
                {'I / FILTRO IZQUIERDO',6,38},
                {'J / DESBORDE DERECHO',18,38},
                {'K / DIVISOR IZQUIERDO',30,38},
                {'L / PUENTE DE DOS ALTURAS',43,33},
            }
            local folder=Instance.new('Folder')
            folder.Name='MegaDemoLabels'
            folder.Parent=session.machines
            for _,entry in ipairs(labels) do
                local anchor=Instance.new('Part')
                anchor.Name='SeccionDemo'
                anchor.Size=Vector3.new(.2,.2,.2)
                anchor.Anchored=true;anchor.Transparency=1
                anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
                anchor.Position=session.origin+Vector3.new(entry[2]*Construction.CELL_SIZE,11,entry[3]*Construction.CELL_SIZE)
                anchor.Parent=folder
                local tag=Instance.new('BillboardGui')
                tag.Size=UDim2.fromOffset(225,37)
                tag.MaxDistance=105
                tag.AlwaysOnTop=true
                tag.Parent=anchor
                local text=Instance.new('TextLabel')
                text.Size=UDim2.fromScale(1,1)
                text.BackgroundColor3=Color3.fromRGB(18,33,45)
                text.TextColor3=Color3.fromRGB(92,228,230)
                text.Font=Enum.Font.GothamBold
                text.TextScaled=true
                text.Text=entry[1]
                text.Parent=tag
            end
            local reply=packet(session)
            reply.ok=true;reply.code='demo_mega'
            command:FireClient(player,reply)
            factoryUpdate:FireClient(player,Simulation.report(session))
            return
        end
        if order.kind=='place_many' then
            local ok,code,ids=Construction.applyMany(session.state,player.UserId,order.placements)
            if ok then
                for _,id in ipairs(ids) do
                    local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                    model:SetAttribute('OwnerUserId',player.UserId)
                    session.models[id]=model
                end
                redrawBelts(session)
            end
            local response=packet(session)
            response.ok=ok
            response.code=code
            response.placed=if ok then #ids else 0
            command:FireClient(player,response)
            if ok then factoryUpdate:FireClient(player,Simulation.report(session)) end
            return
        end
        local ok,code,id=Construction.apply(session.state,player.UserId,order)
        if ok then
            if order.kind=='remove' or order.kind=='remove_many' then
                local list=if order.kind=='remove_many' then id else {id}
                for _,removedId in ipairs(list) do
                    local model=session.models[removedId]
                    if model then model:Destroy() end
                    session.models[removedId]=nil
                    Simulation.forget(session,removedId)
                end
            elseif order.kind=='configure_recipe' then
                -- Cambiar receta descarta las entradas y salidas de la receta previa.
                Simulation.forget(session,id)
                local model=session.models[id]
                if model then model:SetAttribute('RecipeId',session.state.buildings[id].recipeId) end
            elseif order.kind=='configure_filter' then
                local model=session.models[id]
                if model then model:SetAttribute('FilterItem',session.state.buildings[id].filterItem) end
            elseif order.kind=='move' then
                local model=session.models[id]
                if model then
                    Visual.setCargo(model,nil)
                    Visual.pivot(model,session.state.buildings[id],session.origin)
                end
                Simulation.forget(session,id)
            else
                local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                model:SetAttribute('OwnerUserId',player.UserId)
                session.models[id]=model
            end
        end
        if ok then redrawBelts(session) end
        local response=packet(session)
        response.ok=ok
        response.code=code
        response.id=id
        command:FireClient(player,response)
        if ok then factoryUpdate:FireClient(player,Simulation.report(session)) end
    end)
    Players.PlayerAdded:Connect(function(player)
        player.RespawnLocation=lobbySpawn
        player.CharacterAdded:Connect(function(character)
            local session=sessions[player]
            if session then task.spawn(moveCharacter,player,character,session) end
        end)
    end)
    Players.PlayerRemoving:Connect(function(player)
        local session=sessions[player]
        if not session then return end
        sessions[player]=nil
        slots[session.slot]=nil
        for _,model in pairs(session.models) do model:Destroy() end
        local labels=session.machines:FindFirstChild('DemoLabels')
        if labels then labels:Destroy() end
        local recipes=session.machines:FindFirstChild('ProductionDemoLabels')
        if recipes then recipes:Destroy() end
        local megaLabels=session.machines:FindFirstChild('MegaDemoLabels')
        if megaLabels then megaLabels:Destroy() end
        session.models={}
        setPlotOwner(plotInfo[session.slot],nil)
        changed:FireAllClients(availablePlots())
    end)
    for _,player in Players:GetPlayers() do
        player.RespawnLocation=lobbySpawn
        player.CharacterAdded:Connect(function(character)
            local session=sessions[player]
            if session then task.spawn(moveCharacter,player,character,session) end
        end)
    end
    -- Exponer remotos cuando los controladores de servidor ya estén conectados.
    remotes.Parent=ReplicatedStorage
    Simulation.run(sessions,factoryUpdate)
end

return BuildServer
</ProtectedString>
					<string name="ScriptGuid">{45B50732-D055-4E97-951F-B757641DDB5F}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">558304b3c8ae25c20aedcdde000003e5</UniqueId>
					<string name="Name">BuildServer</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5a564aeea1225cb10aedd6b900002055</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA08544330A794B879053431571982A7E">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Cliente de construcción: cintas direccionadas + selección múltiple
-- y selección rectangular en PC. El servidor valida todos los borrados.
local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local UserInputService=game:GetService('UserInputService')
local RunService=game:GetService('RunService')
local GuiService=game:GetService('GuiService')
local Shared=ReplicatedStorage:WaitForChild('Shared')
local Construction=require(Shared:WaitForChild('Construction'))
local Catalog=require(Shared:WaitForChild('MachineCatalog'))
local Visual=require(Shared:WaitForChild('MachineVisual'))
local UI=require(script.Parent:WaitForChild('BuildUI'))
local PointerRay=require(script.Parent:WaitForChild('PointerRay'))
local Controller={}

function Controller.start(initialPacket)
    local player=Players.LocalPlayer
    local remotes=ReplicatedStorage:WaitForChild('Matterloom')
    local getState=remotes:WaitForChild('GetState')
    local commandEvent=remotes:WaitForChild('Command')
    local factoryEvent=remotes:WaitForChild('FactoryState')
    local state,origin,plot,factory
    local mode,selectedId,rotation,chosen='select',nil,0,'Receiver'
    local buildLevel=0
    local candidate,preview,pending=nil,nil,false
    local feedbackUntil=0
    local selectedBulk={}
    local confirmDelete=false
    local confirmUntil=0
    local bulkPointer=nil
    local regionPart=nil
    local actions={}
    local ui=UI.new(actions)
    local catalogOpen=false

    local high=Instance.new('Highlight')
    high.Name='SelectedMatterloomMachine'
    high.FillTransparency=.85
    high.FillColor=Color3.fromRGB(79,218,225)
    high.OutlineColor=Color3.fromRGB(152,249,248)
    high.DepthMode=Enum.HighlightDepthMode.Occluded
    high.Parent=workspace
    local markers=Instance.new('Folder')
    markers.Name='MatterloomBulkSelection_Local'
    markers.Parent=workspace

    local function bulkCount()
        local n=0
        for _ in pairs(selectedBulk) do n+=1 end
        return n
    end
    local function placing() return mode=='place' or mode=='move' end
    local function clearPreview()
        if preview then preview:Destroy();preview=nil end
        candidate=nil
    end
    local function clearRegion()
        if regionPart then regionPart:Destroy();regionPart=nil end
        bulkPointer=nil
    end
    local function redrawMarkers()
        markers:ClearAllChildren()
        if mode~='bulk' or not state or not plot then return end
        local folder=plot:FindFirstChild('Machines')
        if not folder then return end
        for id in pairs(selectedBulk) do
            local record=state.buildings[id]
            local model=record and folder:FindFirstChild(record.machineType..'_'..id)
            local base=model and model:FindFirstChild('Base')
            if base then
                local outline=Instance.new('SelectionBox')
                outline.Name='Selected_'..id
                outline.Adornee=base
                outline.LineThickness=.07
                outline.Color3=Color3.fromRGB(255,206,78)
                outline.SurfaceTransparency=1
                outline.Parent=markers
            end
        end
    end
    local function refresh()
        local count=bulkCount()
        ui:setMode(mode,selectedId,pending,chosen,count,confirmDelete)
        if state then ui:setCount(Construction.count(state)) end
        ui:setFactory(factory,selectedId,count,mode)
        local record=selectedId and state and state.buildings[selectedId]
        local stats=record and factory and factory.inventory and factory.inventory[tostring(selectedId)]
        ui:setDetails(if record then record.machineType elseif mode=='place' then chosen else nil,stats,if record then record.filterItem else nil,if record then record.recipeId else nil)
        ui:setHeight(buildLevel)
        high.Adornee=nil
        if mode~='bulk' and selectedId and state and plot then
            local building=state.buildings[selectedId]
            local folder=plot:FindFirstChild('Machines')
            if folder and building then
                high.Adornee=folder:FindFirstChild(building.machineType..'_'..selectedId)
            end
        end
        redrawMarkers()
    end
    local function feedback(msg,valid)
        feedbackUntil=os.clock()+2.5
        ui:setStatus(msg,valid)
    end
    local function kind()
        local record=if mode=='move' and state then state.buildings[selectedId] else nil
        return if record then record.machineType else chosen
    end
    local function previewAt()
        if not candidate or not placing() or not state then return end
        local typ=kind()
        local valid,code=Construction.canPlace(state,typ,candidate.x,candidate.z,rotation,
            if mode=='move' then selectedId else nil,buildLevel)
        local record={id=0,machineType=typ,x=candidate.x,z=candidate.z,rotation=rotation,level=buildLevel}
        if not preview then preview=Visual.create(workspace,record,origin,true) end
        Visual.pivot(preview,record,origin)
        if typ=='Belt' then
            local feed=Catalog.beltIncoming(state.buildings,record)
            Visual.setBeltIncoming(preview,feed)
        end
        Visual.setPreview(preview,valid)
        if os.clock()&gt;=feedbackUntil then ui:setStatus(Construction.messages[code],valid) end
    end
    local function ray(position,targetParts)
        local camera=workspace.CurrentCamera
        if not camera then return nil end
        local inset=GuiService:GetGuiInset()
        local rayInfo=PointerRay.fromScreen(camera,position,inset)
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances=targetParts
        return workspace:Raycast(rayInfo.Origin,rayInfo.Direction*4096,params)
    end
    local function floorCell(position)
        local floor=plot and plot:FindFirstChild('BuildFloor')
        local hit=if floor then ray(position,{floor}) else nil
        if not hit then return nil end
        local x,z=Construction.worldToCell(hit.Position.X,hit.Position.Z,origin.X,origin.Z)
        if x&lt;0 or z&lt;0 or x&gt;=Construction.GRID_SIZE or z&gt;=Construction.GRID_SIZE then return nil end
        return {x=x,z=z}
    end
    local function groundAt(position)
        local cell=floorCell(position)
        if cell and Catalog.isTransport(kind()) and plot then
            local floor=plot:FindFirstChild('BuildFloor')
            local hit=if floor then ray(position,{floor}) else nil
            if hit then
                local rx=(hit.Position.X-origin.X)/Construction.CELL_SIZE
                local rz=(hit.Position.Z-origin.Z)/Construction.CELL_SIZE
                -- Belt's CENTER can land on a 2-stud sub-grid, aligning it
                -- with the exact middle of a large machine's 8-stud port.
                local bx=math.floor((rx-.5)*2+.5)/2
                local bz=math.floor((rz-.5)*2+.5)/2
                -- Magnetic snap to the CENTER of nearby 2x2 machine ports.
                -- It avoids a half-cell gap even when the player points a little aside.
                local best=2.85
                local initialX,initialZ=bx,bz
                for _,machine in pairs(state.buildings) do
                    if Catalog.types[machine.machineType].size==2 then
                        local snapPorts={}
                        if machine.machineType~='Receiver' then
                            for _,port in ipairs(Catalog.inputPorts(machine)) do table.insert(snapPorts,port) end
                        end
                        if machine.machineType~='Seller' then
                            for _,port in ipairs(Catalog.outputs(machine)) do table.insert(snapPorts,port) end
                        end
                        for _,port in ipairs(snapPorts) do
                            local sx=port.x+port.dx*.5-.5
                            local sz=port.z+port.dz*.5-.5
                            local distance=math.sqrt(((sx-initialX)*Construction.CELL_SIZE)^2
                                +((sz-initialZ)*Construction.CELL_SIZE)^2)
                            if distance&lt;best then
                                local possible=Construction.canPlace(state,kind(),sx,sz,rotation,
                                    if mode=='move' then selectedId else nil,buildLevel)
                                if possible then best=distance;bx=sx;bz=sz end
                            end
                        end
                    end
                end
                cell={x=bx,z=bz}
            end
        end
        if not cell then
            clearPreview()
            if os.clock()&gt;=feedbackUntil then ui:setStatus('Apunta dentro de tu parcela.',false) end
            return
        end
        candidate=cell
        previewAt()
    end
    local function chooseAt(position)
        local folder=plot and plot:FindFirstChild('Machines')
        local hit=if folder then ray(position,{folder}) else nil
        local model=hit and hit.Instance:FindFirstAncestorOfClass('Model')
        local id=nil
        if model and model:GetAttribute('OwnerUserId')==player.UserId and state then
            local found=model:GetAttribute('BuildingId')
            if state.buildings[found] then id=found end
        end
        if mode=='bulk' then
            if id then
                selectedBulk[id]=if selectedBulk[id] then nil else true
                confirmDelete=false
                refresh()
                feedback(string.format('%d estructuras marcadas. Arrastra para seleccionar un área.',bulkCount()),true)
            end
            return
        end
        selectedId=id
        refresh()
        feedback(if selectedId then 'Máquina seleccionada · Mover, Retirar o consultar inventario.'
            else 'Elige una máquina del menú para construir.',nil)
    end
    local function send(order)
        if pending or not state then return end
        pending=true
        refresh()
        feedback('Validando acción con el servidor…',nil)
        commandEvent:FireServer(order)
    end
    local function drawRegion(a,b)
        if not a or not b or not origin then
            if regionPart then regionPart:Destroy();regionPart=nil end
            return
        end
        local loX,hiX=math.min(a.x,b.x),math.max(a.x,b.x)
        local loZ,hiZ=math.min(a.z,b.z),math.max(a.z,b.z)
        if not regionPart then
            regionPart=Instance.new('Part')
            regionPart.Name='MarcoSeleccion_Local'
            regionPart.Anchored=true
            regionPart.CanCollide=false
            regionPart.CanQuery=false
            regionPart.CanTouch=false
            regionPart.Material=Enum.Material.Neon
            regionPart.Color=Color3.fromRGB(83,220,233)
            regionPart.Transparency=.75
            regionPart.Parent=workspace
        end
        regionPart.Size=Vector3.new((hiX-loX+1)*Construction.CELL_SIZE,.12,(hiZ-loZ+1)*Construction.CELL_SIZE)
        regionPart.Position=origin+Vector3.new((loX+hiX+1)*Construction.CELL_SIZE/2,.19,
            (loZ+hiZ+1)*Construction.CELL_SIZE/2)
    end
    local function addRegion(startAt,endAt)
        if not startAt or not endAt or not state then return end
        local minX,maxX=math.min(startAt.x,endAt.x),math.max(startAt.x,endAt.x)
        local minZ,maxZ=math.min(startAt.z,endAt.z),math.max(startAt.z,endAt.z)
        for id,record in pairs(state.buildings) do
            local size=Catalog.types[record.machineType].size
            if record.x&lt;=maxX and record.x+size-1&gt;=minX
                and record.z&lt;=maxZ and record.z+size-1&gt;=minZ then
                selectedBulk[id]=true
            end
        end
        confirmDelete=false
        refresh()
        feedback(string.format('Área seleccionada · %d estructuras marcadas.',bulkCount()),true)
    end

    -- Construcción por arrastre: una sola solicitud al servidor al soltar.
    -- Cada trazo ocupa hasta 64 cintas y se valida de forma atómica.
    local dragStroke=nil
    local dragGhost=Instance.new('Folder')
    dragGhost.Name='MatterloomArrastre_Local'
    dragGhost.Parent=workspace
    local function strokeKey(x,z)
        return string.format('%.1f,%.1f',x,z)
    end
    local function flowRotation(dx,dz)
        if dx&gt;0 then return 3 end
        if dx&lt;0 then return 1 end
        if dz&gt;0 then return 0 end
        return 2
    end
    local function pathRotations(cells)
        local orders={}
        for index,cell in ipairs(cells) do
            local nextCell=cells[index+1]
            local prevCell=cells[index-1]
            local dx,dz=0,0
            if nextCell then
                dx,dz=nextCell.x-cell.x,nextCell.z-cell.z
            elseif prevCell then
                dx,dz=cell.x-prevCell.x,cell.z-prevCell.z
            end
            local rot=if dx==0 and dz==0 then rotation else flowRotation(dx,dz)
            table.insert(orders,{machineType='Belt',x=cell.x,z=cell.z,rotation=rot,level=buildLevel})
        end
        return orders
    end
    local function clearStroke()
        dragStroke=nil
        dragGhost:ClearAllChildren()
    end
    local function drawStroke()
        dragGhost:ClearAllChildren()
        if not dragStroke or not origin then return end
        local planned=pathRotations(dragStroke.cells)
        for _,record in ipairs(planned) do
            local center=origin+Vector3.new((record.x+.5)*Construction.CELL_SIZE,.66,
                (record.z+.5)*Construction.CELL_SIZE)
            local tile=Instance.new('Part')
            tile.Name='CintaPrevista'
            tile.Size=Vector3.new(3.45,.08,3.45)
            tile.Position=center
            tile.Anchored=true
            tile.CanCollide=false
            tile.CanTouch=false
            tile.CanQuery=false
            tile.Material=Enum.Material.SmoothPlastic
            tile.Color=Color3.fromRGB(53,121,128)
            tile.Transparency=.34
            tile.Parent=dragGhost
            -- Línea corta en dirección REAL de la cinta, repetida al arrastrar.
            local dx,dz=Catalog.direction(record.rotation)
            local flow=Vector3.new(-dx,0,-dz)
            local arrow=Instance.new('Part')
            arrow.Name='DireccionPrevista'
            arrow.Anchored=true
            arrow.CanCollide=false
            arrow.CanTouch=false
            arrow.CanQuery=false
            arrow.Material=Enum.Material.SmoothPlastic
            arrow.Color=Color3.fromRGB(245,186,68)
            arrow.Size=Vector3.new(.26,.10,.96)
            arrow.CFrame=CFrame.lookAt(center+Vector3.new(0,.08,0),center+flow+Vector3.new(0,.08,0))
            arrow.Parent=dragGhost
        end
        ui:setStatus(string.format('%d cinta(s) previstas · suelta para construir (máx. 64).',#planned),true)
    end
    local function addStrokeCell(cell)
        if not dragStroke or not cell then return false end
        local last=dragStroke.cells[#dragStroke.cells]
        if last and last.x==cell.x and last.z==cell.z then return false end
        local key=strokeKey(cell.x,cell.z)
        if dragStroke.seen[key] then
            -- Retroceder una casilla con el mouse deshace el último paso.
            local previous=dragStroke.cells[#dragStroke.cells-1]
            if previous and previous.x==cell.x and previous.z==cell.z then
                local popped=table.remove(dragStroke.cells)
                dragStroke.seen[strokeKey(popped.x,popped.z)]=nil
                return true
            end
            return false
        end
        if #dragStroke.cells&gt;=64 then return false end
        local ok=Construction.canPlace(state,'Belt',cell.x,cell.z,rotation,nil,buildLevel)
        if not ok then return false end
        table.insert(dragStroke.cells,{x=cell.x,z=cell.z})
        dragStroke.seen[key]=true
        return true
    end
    local function strokeTo(position)
        if not dragStroke or not state or pending or not plot then return end
        if ui:containsPoint(position) then return end
        groundAt(position)
        if not candidate then return end
        local changed=false
        if #dragStroke.cells==0 then
            changed=addStrokeCell(candidate)
        else
            local last=dragStroke.cells[#dragStroke.cells]
            -- Mantener la misma subcuadrícula de media celda que al comenzar:
            -- las cintas quedan a 4 studs entre sí, aunque el puerto original
            -- de una máquina de 2x2 esté desplazado media casilla.
            local goalX=last.x+math.floor(candidate.x-last.x+.5)
            local goalZ=last.z+math.floor(candidate.z-last.z+.5)
            local tries=0
            while (last.x~=goalX or last.z~=goalZ) and tries&lt;64 do
                tries+=1
                local difX=goalX-last.x
                local difZ=goalZ-last.z
                local x,z=last.x,last.z
                if math.abs(difX)&gt;=math.abs(difZ) and difX~=0 then
                    x+=if difX&gt;0 then 1 else -1
                elseif difZ~=0 then
                    z+=if difZ&gt;0 then 1 else -1
                end
                if x==last.x and z==last.z then break end
                if not addStrokeCell({x=x,z=z}) then break end
                changed=true
                last=dragStroke.cells[#dragStroke.cells]
            end
        end
        if changed then drawStroke() end
    end
    local function beginStroke(position)
        clearStroke()
        dragStroke={cells={},seen={}}
        strokeTo(position)
    end
    local function endStroke()
        if not dragStroke then return end
        local placements=pathRotations(dragStroke.cells)
        clearStroke()
        if #placements==0 then
            feedback('No hay cintas válidas en el recorrido.',false)
            return
        end
        send({kind='place_many',placements=placements})
    end

    actions.catalog=function()
        if dragStroke then clearStroke() end
        catalogOpen=not catalogOpen
        ui:setCatalogOpen(catalogOpen)
    end
    actions.choose=function(machineType)
        clearStroke()
        if pending or not state or not Catalog.types[machineType] then return end
        clearRegion();clearPreview()
        selectedBulk={};confirmDelete=false
        chosen=machineType
        buildLevel=0
        catalogOpen=false
        ui:setCatalogOpen(false)
        selectedId=nil
        rotation=0
        mode='place'
        feedbackUntil=0
        refresh()
        ui:setStatus('Coloca '..Catalog.types[machineType].name..' · R gira entrada, salida y flechas.',nil)
    end
    actions.height=function()
        if pending or not placing() then return end
        if Catalog.types[kind()].size~=1 or Catalog.isElevator(kind()) then
            feedback('Los ascensores y las máquinas grandes ocupan sus alturas fijas.',false)
            return
        end
        buildLevel=(buildLevel+1)%2
        clearPreview()
        refresh()
        feedback('Altura de construcción: NIVEL '..buildLevel..'.',true)
    end
    actions.filter=function()
        if pending or mode~='select' or not selectedId or not state then return end
        local rec=state.buildings[selectedId]
        if not rec or not Catalog.isFilter(rec.machineType) then
            feedback('Selecciona un filtro para cambiar el material.',false)
            return
        end
        local index=table.find(Catalog.filterOrder,rec.filterItem or 'Carbon') or 1
        local nextItem=Catalog.filterOrder[index%#Catalog.filterOrder+1]
        send({kind='configure_filter',id=selectedId,item=nextItem})
    end
    actions.recipe=function()
        if pending or mode~='select' or not selectedId or not state then return end
        local rec=state.buildings[selectedId]
        local options=rec and Catalog.recipeOrder[rec.machineType]
        if not options then feedback('Selecciona una máquina de producción para cambiar su receta.',false);return end
        if #options==1 then feedback('Esta máquina produce un elemento fijo. Para otro, coloca una máquina distinta.',false);return end
        local index=table.find(options,rec.recipeId or options[1]) or 1
        local nextId=options[index%#options+1]
        send({kind='configure_recipe',id=selectedId,recipeId=nextId})
    end
    actions.rotate=function()
        if pending or not placing() then return end
        rotation=Construction.rotate(rotation)
        feedbackUntil=0
        previewAt()
        local dx,dz=Catalog.direction(rotation)
        -- direction() indica el lado de entrada; la salida es el opuesto.
        local toward=if dz==1 then 'NORTE' elseif dz==-1 then 'SUR'
            elseif dx==1 then 'OESTE' else 'ESTE'
        ui:setStatus('Flujo de la cinta hacia '..toward..' · salida cian.',true)
    end
    actions.confirm=function()
        if pending or not state or not placing() then return end
        if not candidate then feedback('Apunta primero a una casilla del suelo.',false);return end
        local typ=kind()
        local valid,code=Construction.canPlace(state,typ,candidate.x,candidate.z,rotation,
            if mode=='move' then selectedId else nil,buildLevel)
        if not valid then feedback(Construction.messages[code],false);return end
        send({kind=if mode=='move' then 'move' else 'place',machineType=typ,
            id=selectedId,x=candidate.x,z=candidate.z,rotation=rotation,level=buildLevel})
    end
    actions.move=function()
        if pending or not selectedId or placing() or mode=='bulk' then return end
        local record=state.buildings[selectedId]
        if not record then return end
        clearPreview()
        chosen=record.machineType
        rotation=record.rotation
        buildLevel=record.level or 0
        candidate={x=record.x,z=record.z}
        mode='move'
        feedbackUntil=0
        refresh()
        previewAt()
    end
    actions.remove=function()
        if not pending and selectedId and mode=='select' then send({kind='remove',id=selectedId}) end
    end
    actions.bulk=function()
        if pending or placing() then return end
        clearPreview();clearRegion()
        if mode=='bulk' then
            selectedBulk={};confirmDelete=false
            mode='select'
            selectedId=nil
            feedback('Selección múltiple finalizada.',nil)
        else
            selectedBulk={}
            if selectedId then selectedBulk[selectedId]=true end
            selectedId=nil
            mode='bulk'
            confirmDelete=false
            feedback('Clic en máquinas para marcar; arrastra sobre el piso para marcar un área.',nil)
        end
        refresh()
    end
    actions.bulkRemove=function()
        if mode~='bulk' or pending then return end
        local n=bulkCount()
        if n==0 then feedback('Primero selecciona las estructuras que deseas retirar.',false);return end
        if not confirmDelete or os.clock()&gt;confirmUntil then
            confirmDelete=true
            confirmUntil=os.clock()+6
            refresh()
            feedback(string.format('Se retirarán %d estructuras. Pulsa «Confirmar» nuevamente.',n),false)
            return
        end
        confirmDelete=false
        local ids={}
        for id in pairs(selectedBulk) do table.insert(ids,id) end
        table.sort(ids)
        send({kind='remove_many',ids=ids})
    end
    actions.cancel=function()
        if pending then return end
        clearStroke()
        clearRegion();clearPreview()
        mode='select'
        selectedId=nil
        selectedBulk={}
        confirmDelete=false
        catalogOpen=false
        ui:setCatalogOpen(false)
        refresh()
        feedback('Acción cancelada.',nil)
    end
    actions.megaDemo=function()
        if pending or placing() or mode=='bulk' then return end
        send({kind='demo_mega'})
    end
    actions.productionDemo=function()
        if pending or placing() or mode=='bulk' then return end
        send({kind='demo_production'})
    end
    actions.demo=function()
        if pending or placing() or mode=='bulk' then return end
        send({kind='demo'})
    end
    commandEvent.OnClientEvent:Connect(function(result)
        pending=false
        if result.state then state=Construction.fromSnapshot(result.state) end
        if result.factory then factory=result.factory end
        if result.ok then
            clearRegion();clearPreview();clearStroke()
            selectedBulk={};confirmDelete=false
            if result.code=='placed_many' then
                -- Sigue en modo cintas, listo para el próximo trazo.
                mode='place'
                selectedId=nil
            else
                mode='select'
                selectedId=if result.code=='removed' or result.code=='removed_many' or result.code=='demo' or result.code=='demo_production' or result.code=='demo_mega' then nil else result.id
            end
        end
        refresh()
        local message=if result.code=='placed_many' then string.format('%d cintas colocadas. Mantén clic para la siguiente línea.',result.placed or 0)
            elseif result.code=='demo' then 'Demo logística creada: 8 zonas, 10 dispositivos y puente elevado.'
            elseif result.code=='demo_production' then 'Demo producción creada: 4 líneas con recetas e ingredientes reales.'
            elseif result.code=='demo_mega' then 'Mega fábrica lista: cadenas, filtros, divisores, almacenes y ascensores.'
            elseif result.code=='mega_requires_empty' then 'Para crear la Mega Demo, selecciona una parcela sin máquinas. No se borrará tu fábrica actual.'
            elseif result.code=='mega_blocked' then 'No se pudo construir la Mega Demo. Revisa terreno/capacidad: '..tostring(result.detail or 'desconocido')
            elseif result.code=='demo_blocked' then 'Demo bloqueada: despeja el terreno o elige una parcela vacía.'
            else Construction.messages[result.code] or 'No se pudo completar la acción.'
        feedback(message,result.ok)
    end)
    factoryEvent.OnClientEvent:Connect(function(data)
        factory=data
        refresh()
    end)
    local ok,response
    if initialPacket then ok,response=true,initialPacket
    else ok,response=pcall(function() return getState:InvokeServer() end) end
    if not ok or not response or response.error then
        ui:setMode('select',nil,true,chosen)
        ui:setStatus(if response and response.error then response.error else 'No se pudo cargar la parcela.',false)
        return
    end
    state=Construction.fromSnapshot(response.state)
    origin=response.origin
    factory=response.factory
    plot=workspace:WaitForChild('MatterloomPlots'):WaitForChild('Plot_'..player.UserId)
    refresh()
    GuiService.MenuOpened:Connect(actions.cancel)

    UserInputService.InputBegan:Connect(function(input,processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode==Enum.KeyCode.R then actions.rotate()
        elseif input.KeyCode==Enum.KeyCode.B then actions.catalog()
        elseif input.KeyCode==Enum.KeyCode.T then actions.height()
        elseif input.KeyCode==Enum.KeyCode.F then actions.filter()
        elseif input.KeyCode==Enum.KeyCode.G then actions.recipe()
        elseif input.KeyCode==Enum.KeyCode.V then actions.bulk()
        elseif input.KeyCode==Enum.KeyCode.Delete or input.KeyCode==Enum.KeyCode.Backspace then
            if mode=='bulk' then actions.bulkRemove() end
        elseif input.KeyCode==Enum.KeyCode.Escape then actions.cancel()
        elseif input.UserInputType==Enum.UserInputType.MouseButton1 and not pending then
            local position=UserInputService:GetMouseLocation()
            if ui:containsPoint(position) then return end
            if mode=='bulk' then
                bulkPointer={screen=position,cell=floorCell(position)}
            elseif mode=='place' and kind()=='Belt' then
                beginStroke(position)
            elseif placing() then
                groundAt(position);actions.confirm()
            else chooseAt(position) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
        if dragStroke then
            strokeTo(UserInputService:GetMouseLocation())
            endStroke()
            return
        end
        if not bulkPointer then return end
        local start=bulkPointer
        local finish=UserInputService:GetMouseLocation()
        local delta=(finish-start.screen).Magnitude
        local endCell=floorCell(finish)
        clearRegion()
        if mode~='bulk' or pending then return end
        if delta&gt;12 and start.cell and endCell then
            addRegion(start.cell,endCell)
        elseif delta&lt;=12 and not ui:containsPoint(finish) then
            chooseAt(finish)
        end
    end)
    UserInputService.TouchTapInWorld:Connect(function(position,processed)
        if processed or pending or ui:containsPoint(position) then return end
        if placing() then groundAt(position);actions.confirm()
        else chooseAt(position) end
    end)
    local accumulated=0
    RunService.RenderStepped:Connect(function(dt)
        accumulated+=dt
        if accumulated&lt;.05 then return end
        accumulated=0
        if dragStroke then
            strokeTo(UserInputService:GetMouseLocation())
        elseif mode=='bulk' and bulkPointer then
            local current=UserInputService:GetMouseLocation()
            if (current-bulkPointer.screen).Magnitude&gt;12 then
                drawRegion(bulkPointer.cell,floorCell(current))
            end
        elseif not pending and placing() and UserInputService.PreferredInput~=Enum.PreferredInput.Touch then
            local position=UserInputService:GetMouseLocation()
            if not ui:containsPoint(position) then groundAt(position) end
        end
        if selectedId and not high.Adornee then refresh() end
        if confirmDelete and os.clock()&gt;confirmUntil then
            confirmDelete=false
            refresh()
        end
    end)
    player.CharacterAdded:Connect(function()
        if not pending then actions.cancel() end
    end)
end
return Controller
</ProtectedString>
					<string name="ScriptGuid">{9F7DC87D-3566-4308-AF8E-27E48C1A7DA1}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">558304b3c8ae25c20aedcdde000003eb</UniqueId>
					<string name="Name">BuildController</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5a564aeea1225cb10aedd6b900002057</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX76DEC98785DA492385E6BF7CA1DA3050">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
local Players=game:GetService('Players')
local UserInputService=game:GetService('UserInputService')
local Catalog=require(game:GetService('ReplicatedStorage').Shared.MachineCatalog)
local UI={}
local colors={
    panel=Color3.fromRGB(16,27,38),border=Color3.fromRGB(56,91,108),
    text=Color3.fromRGB(230,243,249),muted=Color3.fromRGB(155,183,196),
    cyan=Color3.fromRGB(88,224,227),button=Color3.fromRGB(39,60,74)
}
local function rounded(x,r)
    local u=Instance.new('UICorner')
    u.CornerRadius=UDim.new(0,r)
    u.Parent=x
end
local function label(parent,name,value,size,pos,dimensions,color)
    local t=Instance.new('TextLabel')
    t.Name=name
    t.BackgroundTransparency=1
    t.Position=pos
    t.Size=dimensions
    t.Text=value
    t.TextColor3=color or colors.text
    t.Font=Enum.Font.GothamMedium
    t.TextSize=size
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.Parent=parent
    return t
end
local function frame(parent,name,pos,sz,anchor,maxWidth)
    local f=Instance.new('Frame')
    f.Name=name
    f.Position=pos
    f.Size=sz
    f.AnchorPoint=anchor
    f.BackgroundColor3=colors.panel
    f.BorderSizePixel=0
    f.Parent=parent
    rounded(f,12)
    local stroke=Instance.new('UIStroke')
    stroke.Color=colors.border
    stroke.Parent=f
    local clamp=Instance.new('UISizeConstraint')
    clamp.MaxSize=Vector2.new(maxWidth,2000)
    clamp.Parent=f
    return f
end
local function button(parent,name,title,callback)
    local b=Instance.new('TextButton')
    b.Name=name
    b.Text=title
    b.Font=Enum.Font.GothamBold
    b.TextSize=12
    b.TextColor3=colors.text
    b.BackgroundColor3=colors.button
    b.BorderSizePixel=0
    b.Parent=parent
    rounded(b,7)
    b.Activated:Connect(callback)
    return b
end
function UI.new(callbacks)
    local screen=Instance.new('ScreenGui')
    screen.Name='MatterloomFabricaUI'
    screen.ResetOnSpawn=false
    screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    screen.Parent=Players.LocalPlayer:WaitForChild('PlayerGui')

    -- HUD visible even with the construction catalog closed.
    local header=frame(screen,'Header',UDim2.new(.5,0,0,8),UDim2.new(.91,0,0,85),Vector2.new(.5,0),580)
    local title=label(header,'Title','MATTERLOOM  ·  FÁBRICA',18,UDim2.fromOffset(13,8),UDim2.new(1,-26,0,23),colors.cyan)
    title.Font=Enum.Font.GothamBold
    label(header,'Stage','06.0 / MODELOS BLENDER',10,UDim2.fromOffset(13,32),UDim2.new(1,-26,0,17),colors.muted)
    local counter=label(header,'Counter','0 / 280 estructuras',12,UDim2.fromOffset(13,57),UDim2.new(.48,0,0,18))
    local cash=label(header,'Cash','Créditos: $0  ·  Vendidos: 0',12,UDim2.new(.43,0,0,57),UDim2.new(.57,-12,0,18),colors.cyan)

    local buildButton=button(screen,'BuildButton','⚒  CONSTRUIR  [B]',function()
        if callbacks.catalog then callbacks.catalog() end
    end)
    buildButton.Position=UDim2.fromOffset(14,113)
    buildButton.Size=UDim2.fromOffset(165,46)
    buildButton.TextSize=14
    buildButton.BackgroundColor3=Color3.fromRGB(26,60,74)
    buildButton.ZIndex=12

    -- Actions remain accessible while the catalog is collapsed.
    local dock=frame(screen,'ConstructionActions',UDim2.new(.5,0,1,-8),UDim2.new(.94,0,0,250),Vector2.new(.5,1),720)
    local modeText=label(dock,'Mode','Selecciona una estructura o abre Construir.',13,UDim2.fromOffset(12,7),UDim2.new(1,-24,0,20),colors.cyan)
    local status=label(dock,'Status','Mantén clic y arrastra sobre el suelo para colocar cintas en cadena.',11,
        UDim2.fromOffset(12,29),UDim2.new(1,-24,0,28),colors.muted)
    status.TextWrapped=true
    local actions={}
    local actionFrame=Instance.new('Frame')
    actionFrame.Name='Actions'
    actionFrame.BackgroundTransparency=1
    actionFrame.Position=UDim2.fromOffset(12,62)
    actionFrame.Size=UDim2.new(1,-24,0,155)
    actionFrame.Parent=dock
    local layout=Instance.new('UIGridLayout')
    layout.CellSize=UDim2.new(.333,-6,0,34)
    layout.CellPadding=UDim2.fromOffset(7,6)
    layout.SortOrder=Enum.SortOrder.LayoutOrder
    layout.Parent=actionFrame
    for n,item in ipairs({{'rotate','Girar · R'},{'confirm','Colocar'},{'move','Mover'},
        {'remove','Retirar 1'},{'bulk','Elegir varios · V'},{'bulkRemove','Borrar grupo'},
        {'cancel','Cancelar'},{'recipe','Receta · G'},
        {'demo','Demo logística'},{'productionDemo','Demo producción'},
        {'megaDemo','MEGA DEMO ★'}}) do
        local b=button(actionFrame,item[1],item[2],function() if callbacks[item[1]] then callbacks[item[1]]() end end)
        b.TextSize=11
        b.LayoutOrder=n
        actions[item[1]]=b
    end
    local info=label(dock,'Info','Mantén clic y arrastra para construir cintas. R gira.',10,
        UDim2.fromOffset(12,227),UDim2.new(1,-24,0,17),colors.muted)
    info.TextTruncate=Enum.TextTruncate.AtEnd

    -- Pop-up with the categories from the user's screenshots.
    local catalog=frame(screen,'Catalogo',UDim2.new(.5,0,1,-266),UDim2.new(.94,0,0,246),Vector2.new(.5,1),720)
    catalog.Visible=false
    catalog.ZIndex=14
    local catalogTitle=label(catalog,'TituloCatalogo','CATÁLOGO DE CONSTRUCCIÓN',15,
        UDim2.fromOffset(13,8),UDim2.new(1,-56,0,24),colors.cyan)
    catalogTitle.Font=Enum.Font.GothamBold
    local close=button(catalog,'Cerrar','✕',function() if callbacks.catalog then callbacks.catalog() end end)
    close.Size=UDim2.fromOffset(37,30)
    close.Position=UDim2.new(1,-44,0,6)
    close.ZIndex=17
    local tabs=Instance.new('Frame')
    tabs.Name='Categories'
    tabs.BackgroundTransparency=1
    tabs.Position=UDim2.fromOffset(12,40)
    tabs.Size=UDim2.new(1,-24,0,34)
    tabs.ZIndex=15
    tabs.Parent=catalog
    local tabLayout=Instance.new('UIGridLayout')
    tabLayout.CellSize=UDim2.new(.2,-5,0,32)
    tabLayout.CellPadding=UDim2.fromOffset(5,0)
    tabLayout.SortOrder=Enum.SortOrder.LayoutOrder
    tabLayout.Parent=tabs
    -- Panel lateral: nombre en catálogo y explicación/receta al costado.
    local detail=frame(screen,'DetalleMaquina',UDim2.new(1,-14,0,176),UDim2.fromOffset(302,338),Vector2.new(1,0),310)
    detail.Visible=false
    detail.ZIndex=11
    local detailTitle=label(detail,'DetalleNombre','MÁQUINA',16,UDim2.fromOffset(13,10),UDim2.new(1,-26,0,26),colors.cyan)
    detailTitle.Font=Enum.Font.GothamBold
    local detailDescription=label(detail,'Descripcion','',12,UDim2.fromOffset(13,43),UDim2.new(1,-26,0,43),colors.text)
    detailDescription.TextWrapped=true
    detailDescription.TextYAlignment=Enum.TextYAlignment.Top
    label(detail,'EncabezadoEntrada','NECESITA / ENTRADA',10,UDim2.fromOffset(13,91),UDim2.new(1,-26,0,20),colors.cyan)
    local detailInput=label(detail,'Insumos','',11,UDim2.fromOffset(13,114),UDim2.new(1,-26,0,38),colors.text)
    detailInput.TextWrapped=true
    detailInput.TextYAlignment=Enum.TextYAlignment.Top
    label(detail,'EncabezadoSalida','PRODUCE / SALIDA',10,UDim2.fromOffset(13,159),UDim2.new(1,-26,0,20),colors.cyan)
    local detailOutput=label(detail,'Productos','',11,UDim2.fromOffset(13,183),UDim2.new(1,-26,0,40),colors.text)
    detailOutput.TextWrapped=true
    detailOutput.TextYAlignment=Enum.TextYAlignment.Top
    local detailCycle=label(detail,'Ciclo','',11,UDim2.fromOffset(13,234),UDim2.new(1,-26,0,19),colors.cyan)
    local detailNotes=label(detail,'Notas','',10,UDim2.fromOffset(13,256),UDim2.new(1,-26,0,45),colors.muted)
    detailNotes.TextWrapped=true
    detailNotes.TextYAlignment=Enum.TextYAlignment.Top
    local detailRuntime=label(detail,'Inventario','',10,UDim2.fromOffset(13,308),UDim2.new(1,-26,0,22),colors.muted)
    local currentType,liveStats,hoverType,filterSelection,selectedRecipe=nil,nil,nil,nil,nil
    local function renderDetail()
        local machineType=hoverType or currentType or (catalog.Visible and 'Receiver' or nil)
        detail.Visible=machineType~=nil
        if not machineType then return end
        local cfg=Catalog.types[machineType]
        local recipe=Catalog.details[machineType]
        if not cfg or not recipe then detail.Visible=false;return end
        detailTitle.Text=cfg.name:upper()
        detailDescription.Text=cfg.description
        local chosenRecipe=Catalog.recipes[if machineType==currentType then selectedRecipe or '' else Catalog.recipeId(machineType) or '']
        if chosenRecipe and Catalog.hasRecipes(machineType) then
            detailInput.Text=table.concat(Catalog.recipeLines(chosenRecipe,'inputs'),'\n')
            detailOutput.Text=if chosenRecipe.alternate then 'Carbono u Oxígeno ×1 (alternados)' else table.concat(Catalog.recipeLines(chosenRecipe,'outputs'),'\n')
            detailCycle.Text='RECETA · '..chosenRecipe.name..'  |  '..chosenRecipe.seconds..' s'
        else
            detailInput.Text=table.concat(recipe.inputs,'\n')
            detailOutput.Text=table.concat(recipe.outputs,'\n')
            detailCycle.Text='TIEMPO · '..recipe.cycle
        end
        detailNotes.Text=recipe.notes..(if Catalog.isFilter(machineType) then (' | FILTRA: '..(Catalog.items[filterSelection or 'Carbon'] or Catalog.items.Carbon).name..' · F') elseif chosenRecipe and #(Catalog.recipeOrder[machineType] or {})&gt;1 then ' | G: elegir receta' else '')
        detailRuntime.Text=''
        if machineType==currentType and liveStats then
            detailRuntime.Text=string.format('Dentro: %d  ·  Salida: %d  ·  Fabricados: %d',
                liveStats.inside or 0,liveStats.output or 0,liveStats.produced or 0)
        end
    end
    local entries={
        Especial={'Receiver','Storage','Seller'},
        Transporte={'Belt','ElevatorUp','ElevatorDown','SplitterLeft','SplitterRight','SplitterThree','OverflowLeft','OverflowRight','FilterLeft','FilterRight'},
        ['Producción']={'CarbonProcessor','OxygenProcessor','SiliconProcessor','IronProcessor','CopperProcessor','HydrogenProcessor','FusionChamber','ElementSynthesizer','Crystallizer','MineralFormer','Smelter'},
        Edificio={},
        ['Decoración']={},
    }
    local categoryOrder={'Especial','Transporte','Producción','Edificio','Decoración'}
    local tabButtons={}
    local machineButtons={}
    local items=Instance.new('ScrollingFrame')
    items.Name='Componentes'
    items.BackgroundTransparency=1
    items.BorderSizePixel=0
    items.ScrollBarThickness=5
    items.ScrollBarImageColor3=colors.cyan
    items.Position=UDim2.fromOffset(12,84)
    items.Size=UDim2.new(1,-24,1,-96)
    items.CanvasSize=UDim2.fromOffset(0,0)
    items.AutomaticCanvasSize=Enum.AutomaticSize.Y
    items.ZIndex=15
    items.Parent=catalog
    local itemGrid=Instance.new('UIGridLayout')
    itemGrid.SortOrder=Enum.SortOrder.LayoutOrder
    itemGrid.CellSize=UDim2.new(.333,-8,0,66)
    itemGrid.CellPadding=UDim2.fromOffset(8,8)
    itemGrid.Parent=items
    local empty=label(items,'SinComponentes','Próximamente: nuevas estructuras.',13,
        UDim2.fromOffset(8,10),UDim2.new(1,-16,0,40),colors.muted)
    empty.TextXAlignment=Enum.TextXAlignment.Center
    empty.ZIndex=17
    local activeCategory='Especial'
    local function showCategory(category)
        activeCategory=category
        for name,b in pairs(tabButtons) do
            b.BackgroundColor3=if name==category then Color3.fromRGB(18,103,112) else colors.button
        end
        for kind,b in pairs(machineButtons) do
            b.Visible=table.find(entries[category] or {},kind)~=nil
        end
        empty.Visible=#(entries[category] or {})==0
        items.CanvasPosition=Vector2.zero
    end
    for index,category in ipairs(categoryOrder) do
        local b=button(tabs,'Tab_'..index,category,function() showCategory(category) end)
        b.TextSize=11
        b.LayoutOrder=index
        b.ZIndex=16
        tabButtons[category]=b
    end
    for index,kind in ipairs(Catalog.order) do
        local data=Catalog.types[kind]
        local b=button(items,kind,data.name,function()
            if callbacks.choose then callbacks.choose(kind) end
        end)
        b.LayoutOrder=index
        b.TextSize=12
        b.TextWrapped=true
        b.ZIndex=16
        machineButtons[kind]=b
        b.MouseEnter:Connect(function() hoverType=kind;renderDetail() end)
        b.MouseLeave:Connect(function() hoverType=nil;renderDetail() end)
    end
    showCategory('Especial')
    local self={screen=screen,actions=actions,machineButtons=machineButtons,catalog=catalog}
    function self:setCatalogOpen(open)
        catalog.Visible=open
        if not open then hoverType=nil end
        renderDetail()
        buildButton.Text=if open then '✕  CERRAR  [B]' else '⚒  CONSTRUIR  [B]'
        buildButton.BackgroundColor3=if open then Color3.fromRGB(20,103,109) else Color3.fromRGB(26,60,74)
    end
    function self:setDetails(machineType,stats,filterItem,recipeId)
        currentType=machineType
        liveStats=stats
        filterSelection=filterItem
        selectedRecipe=recipeId
        renderDetail()
    end
    function self:setHeight(level)
        buildButton.Text=if catalog.Visible then '✕  CERRAR  [B]' else '⚒  CONSTRUIR  [B]'
        info:SetAttribute('BuildLevel',level)
    end
    function self:setMode(mode,selectedId,pending,kind,bulkCount,confirmDelete)
        bulkCount=bulkCount or 0
        local placing=mode=='place' or mode=='move'
        modeText.Text=if mode=='move' then 'MOVER · elige una nueva posición'
            elseif mode=='place' then 'COLOCAR · '..Catalog.types[kind].name
            elseif mode=='bulk' then string.format('SELECCIÓN MÚLTIPLE · %d marcadas',bulkCount)
            elseif selectedId then 'ESTRUCTURA #'..selectedId..' SELECCIONADA'
            else 'Elige una máquina en CONSTRUIR o selecciona una del terreno.'
        for typ,b in pairs(machineButtons) do
            b.Active=not pending
            b.Interactable=not pending
            b.TextTransparency=if pending then .55 else 0
            b.BackgroundColor3=if typ==kind and mode=='place' then Color3.fromRGB(20,110,113) else colors.button
        end
        local multi=mode=='bulk'
        local enabled={rotate=placing,confirm=placing,move=selectedId~=nil and not placing and not multi,
            remove=selectedId~=nil and not placing and not multi,
            bulk=not placing,bulkRemove=multi and bulkCount&gt;0,
            recipe=selectedId~=nil and not placing and not multi,productionDemo=not placing and not multi,megaDemo=not placing and not multi,
            cancel=placing or selectedId~=nil or multi,demo=not placing and not multi}
        for key,b in pairs(actions) do
            b.Interactable=not pending and enabled[key]
            b.Active=not pending and enabled[key]
            b.TextTransparency=if b.Active then 0 else .6
            b.BackgroundColor3=if key=='confirm' and b.Active then Color3.fromRGB(27,111,116) else colors.button
        end
        actions.confirm.Text=if pending then 'Espera…' elseif mode=='move' then 'Confirmar' elseif kind=='Belt' and placing then 'Colocar 1' else 'Colocar'
        actions.bulk.Text=if multi then 'Salir de selección' else 'Elegir varios · V'
        actions.bulkRemove.Text=if confirmDelete then string.format('CONFIRMAR (%d)',bulkCount)
            else string.format('BORRAR (%d)',bulkCount)
    end
    function self:setStatus(message,valid)
        status.Text=message
        status.TextColor3=if valid==true then Color3.fromRGB(145,233,182)
            elseif valid==false then Color3.fromRGB(248,151,161) else colors.muted
    end
    function self:setCount(n) counter.Text=string.format('%d / 280 estructuras · 48 × 48',n) end
    function self:setFactory(report,selectedId,bulkCount,mode)
        if not report then return end
        cash.Text=string.format('Créditos: $%d · Vendidos: %d',report.cash or 0,report.sales or 0)
        if mode=='bulk' then
            info.Text=string.format('%d seleccionadas · clic para marcar · arrastra sobre un área.',bulkCount or 0)
            return
        end
        if selectedId then
            local r=report.inventory and report.inventory[tostring(selectedId)]
            if r then
                info.Text=string.format('#%d  ·  entra: %d  ·  sale: %d  ·  producido: %d  ·  enviado: %d',
                    selectedId,r.inside or 0,r.output or 0,r.produced or 0,r.moved or 0)
                return
            end
        end
        info.Text='B: catálogo · G: receta · F: filtro · R: girar · T: altura · V: selección múltiple.'
    end
    function self:containsPoint(position)
        local gui=Players.LocalPlayer:FindFirstChild('PlayerGui')
        if not gui then return false end
        for _,v in ipairs(gui:GetGuiObjectsAtPosition(position.X,position.Y)) do
            if v:IsDescendantOf(screen) then return true end
        end
        return false
    end
    local viewportConn
    local function adapt()
        local camera=workspace.CurrentCamera
        if not camera then return end
        local touch=UserInputService.PreferredInput==Enum.PreferredInput.Touch
        local short=camera.ViewportSize.Y&lt;640
        local narrow=camera.ViewportSize.X&lt;610
        header.Visible=not short
        buildButton.Position=UDim2.fromOffset(12,if short then 12 else 110)
        dock:FindFirstChildOfClass('UISizeConstraint').MaxSize=Vector2.new(if touch then 395 else 720,2000)
        dock.AnchorPoint=Vector2.new(.5,1)
        dock.Position=UDim2.new(.5,0,1,-8)
        catalog:FindFirstChildOfClass('UISizeConstraint').MaxSize=Vector2.new(if touch then 395 else 720,2000)
        catalog.Position=UDim2.new(.5,0,1,-266)
        itemGrid.CellSize=if narrow then UDim2.new(.5,-6,0,68) else UDim2.new(.333,-8,0,66)
        detail.Visible=not narrow and (hoverType~=nil or currentType~=nil or catalog.Visible)
        detail.Position=UDim2.new(1,-14,0,if short then 16 else 176)
    end
    local function bindCamera()
        if viewportConn then viewportConn:Disconnect() end
        local camera=workspace.CurrentCamera
        if camera then viewportConn=camera:GetPropertyChangedSignal('ViewportSize'):Connect(adapt) end
        adapt()
    end
    workspace:GetPropertyChangedSignal('CurrentCamera'):Connect(bindCamera)
    UserInputService:GetPropertyChangedSignal('PreferredInput'):Connect(adapt)
    bindCamera()
    self:setMode('select',nil,false,nil)
    return self
end
return UI
