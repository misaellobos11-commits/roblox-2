}

-- Recetas de juego (simplificadas; NO representan reacciones reales).
-- El servidor comprueba las entradas, consume materiales y produce la salida.
C.recipes={
 special_carbon={name='Carbono',inputs={RawMatter=1},outputs={Carbon=1},seconds=2.0},
 special_oxygen={name='Oxígeno',inputs={RawMatter=1},outputs={Oxygen=1},seconds=2.2},
 special_silicon={name='Silicio',inputs={RawMatter=1},outputs={Silicon=1},seconds=2.6},
 special_iron={name='Hierro',inputs={RawMatter=1},outputs={Iron=1},seconds=2.7},
 special_copper={name='Cobre',inputs={RawMatter=1},outputs={Copper=1},seconds=2.8},
 special_hydrogen={name='Hidrógeno',inputs={RawMatter=1},outputs={Hydrogen=1},seconds=2.5},
 fusion_carbon={name='Compuesto de carbono',inputs={Carbon=1,Oxygen=1},outputs={CarbonCompound=1},seconds=3},
 fusion_silicate={name='Silicato',inputs={Silicon=1,Oxygen=1},outputs={Silicate=1},seconds=3},
 synth_metal={name='Compuesto metálico',inputs={Iron=1,Carbon=1},outputs={BaseMetal=1},seconds=3.2},
 synth_conductor={name='Mezcla conductiva',inputs={Copper=1,Silicon=1},outputs={ConductiveMix=1},seconds=3.2},
 crystal_basic={name='Cristal básico',inputs={Silicate=1},outputs={BasicCrystal=1},seconds=3.5},
 form_ore={name='Mineral sintético',inputs={BaseMetal=1},outputs={SyntheticOre=1},seconds=3.5},
 melt_ingot={name='Lingote',inputs={SyntheticOre=1},outputs={Ingot=1},seconds=4},
}
C.recipeOrder={
 CarbonProcessor={'special_carbon'},
 OxygenProcessor={'special_oxygen'},
 SiliconProcessor={'special_silicon'},
 IronProcessor={'special_iron'},
 CopperProcessor={'special_copper'},
 HydrogenProcessor={'special_hydrogen'},
 FusionChamber={'fusion_carbon','fusion_silicate'},
 ElementSynthesizer={'synth_metal','synth_conductor'},
 Crystallizer={'crystal_basic'},
 MineralFormer={'form_ore'},
 Smelter={'melt_ingot'},
}
function C.hasRecipes(machineType) return C.recipeOrder[machineType]~=nil end
function C.recipeFor(record)
 local list=C.recipeOrder[record.machineType]
 if not list then return nil end
 local id=record.recipeId
 if not id or not table.find(list,id) then id=list[1] end
 return C.recipes[id]
end
function C.recipeId(machineType) local list=C.recipeOrder[machineType]; return list and list[1] end
function C.recipeLines(recipe,field)
 local entries={}
 for item,amount in pairs(recipe[field] or {}) do
  local display=C.items[item]
  table.insert(entries,(display and display.name or item)..' ×'..amount)
 end
 table.sort(entries)
 return entries
end

function C.isTransport(typ) return C.types[typ] and C.types[typ].size==1 end
function C.isFilter(typ) return typ=='FilterRight' or typ=='FilterLeft' end
function C.isElevator(typ) return typ=='ElevatorUp' or typ=='ElevatorDown' end
function C.direction(rotation)
 if rotation==0 then return 0,-1 end
 if rotation==1 then return 1,0 end
 if rotation==2 then return 0,1 end
 return -1,0
end
function C.forward(rotation)
 local x,z=C.direction(rotation)
 -- La salida visual de las máquinas y cintas debe coincidir con la dirección elegida.
 -- En versiones anteriores esto estaba invertido.
 return x,z
end
function C.height(rec,kind)
 local level=rec.level or 0
 if rec.machineType=='ElevatorUp' then return if kind=='input' then 0 else 1 end
 if rec.machineType=='ElevatorDown' then return if kind=='input' then 1 else 0 end
 return level
end
function C.dualInput(rec)
 return rec.machineType=='FusionChamber' or rec.machineType=='ElementSynthesizer'
end
function C.inputPorts(rec)
 if C.dualInput(rec) then
  return {C.port(rec,'input','left_in'),C.port(rec,'input','right_in')}
 end
 return {C.port(rec,'input','back')}
end
function C.port(rec,kind,tag)
 local def=C.types[rec.machineType]
 if not def then return nil end
 local fx,fz=C.forward(rec.rotation)
 local dir=tag or (if kind=='input' then 'back' else 'front')
 local dx,dz=fx,fz
 local centerX=rec.x+def.size/2
 local centerZ=rec.z+def.size/2
 local offsetX,offsetZ=0,0
 if dir=='back' then
  dx,dz=-fx,-fz
 elseif dir=='right' then
  dx,dz=fz,-fx
 elseif dir=='left' then
  dx,dz=-fz,fx
 elseif dir=='left_in' then
  dx,dz=-fz,fx
  offsetX,offsetZ=0,0
 elseif dir=='right_in' then
  dx,dz=fz,-fx
  offsetX,offsetZ=0,0
 end
 return {x=centerX+dx*def.size/2+offsetX,z=centerZ+dz*def.size/2+offsetZ,dx=dx,dz=dz,level=C.height(rec,kind),tag=dir}
end
function C.outputs(rec)
 local t=rec.machineType
 if t=='Seller' then return {} end
 if t=='SplitterRight' or t=='OverflowRight' or t=='FilterRight' then return {C.port(rec,'output','front'),C.port(rec,'output','right')} end
 if t=='SplitterLeft' or t=='OverflowLeft' or t=='FilterLeft' then return {C.port(rec,'output','front'),C.port(rec,'output','left')} end
 if t=='SplitterThree' then return {C.port(rec,'output','left'),C.port(rec,'output','front'),C.port(rec,'output','right')} end
 return {C.port(rec,'output','front')}
end
local function close(a,b) return math.abs(a-b)&lt;1e-4 end
function C.portMatches(sourcePort,target)
 if not sourcePort or sourcePort.level~=C.height(target,'input') then return false end
 local t=target.machineType
 if t=='Receiver' then return false end
 if t=='Belt' then
   local fx,fz=C.forward(target.rotation)
   if sourcePort.dx==-fx and sourcePort.dz==-fz then return false end
   local cx,cz=target.x+.5,target.z+.5
   return close(sourcePort.x,cx-sourcePort.dx*.5) and close(sourcePort.z,cz-sourcePort.dz*.5)
 end
 for _,input in ipairs(C.inputPorts(target)) do
  if close(sourcePort.x,input.x) and close(sourcePort.z,input.z)
     and sourcePort.dx==-input.dx and sourcePort.dz==-input.dz then
   return true
  end
 end
 return false
end
function C.connected(a,b)
 if a.id==b.id then return false end
 for _,port in ipairs(C.outputs(a)) do
   if C.portMatches(port,b) then return true end
 end
 return false
end
function C.neighbors(buildings,source)
 local neighbors={}
 for _,port in ipairs(C.outputs(source)) do
   local matches={}
   for _,target in pairs(buildings) do
     if source.id~=target.id and C.portMatches(port,target) then table.insert(matches,target) end
   end
   table.sort(matches,function(a,b) return a.id&lt;b.id end)
   neighbors[port.tag]=matches
 end
 return neighbors
end
function C.routeOrder(rec,item,roundRobin)
 local t=rec.machineType
 if t=='SplitterRight' then return {'right','front'} end
 if t=='SplitterLeft' then return {'left','front'} end
 if t=='OverflowRight' then return {'front','right'} end
 if t=='OverflowLeft' then return {'front','left'} end
 if t=='FilterLeft' then return if item==(rec.filterItem or 'Carbon') then {'left'} else {'front'} end
 if t=='FilterRight' then return if item==(rec.filterItem or 'Carbon') then {'right'} else {'front'} end
 if t=='SplitterThree' then
   local opts={'left','front','right'}
   local start=(roundRobin or 0)%3
   return {opts[start+1],opts[(start+1)%3+1],opts[(start+2)%3+1]}
 end
 return {'front'}
end
function C.beltIncoming(buildings,target)
 local best,bestPort=nil,nil
 for _,source in pairs(buildings) do
   if source.id~=target.id then
     for _,port in ipairs(C.outputs(source)) do
       if C.portMatches(port,target) and (not best or source.id&lt;best.id) then
         best=source;bestPort=port
       end
     end
   end
 end
 return if bestPort then {dx=bestPort.dx,dz=bestPort.dz} else nil
end
return table.freeze(C)
</ProtectedString>
					<string name="ScriptGuid">{7CE45F5F-EB60-4A01-B34A-F1E2BB79A824}</string>
