                {t='Seller',x=34,z=29,r=0,level=0},
            }
            local staged=Construction.fromSnapshot(Construction.snapshot(session.state))
            local valid=true
            for _,entry in ipairs(demo) do
                local ok=Construction.apply(staged,player.UserId,{kind='place',machineType=entry.t,
                    x=entry.x,z=entry.z,rotation=entry.r,level=entry.level})
                if not ok then valid=false;break end
            end
            if not valid then
                local reply=packet(session)
                reply.ok=false;reply.code='demo_blocked'
                command:FireClient(player,reply)
                return
            end
            for _,entry in ipairs(demo) do
                local ok,_,id=Construction.apply(session.state,player.UserId,{kind='place',machineType=entry.t,
                    x=entry.x,z=entry.z,rotation=entry.r,level=entry.level})
                if ok then
                    if entry.recipeId then
                        Construction.apply(session.state,player.UserId,{kind='configure_recipe',id=id,recipeId=entry.recipeId})
                    end
                    local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                    model:SetAttribute('OwnerUserId',player.UserId)
                    session.models[id]=model
                end
            end
            redrawBelts(session)
            local folder=Instance.new('Folder')
            folder.Name='ProductionDemoLabels'
            folder.Parent=session.machines
            local legends={
                {'A · COMPUESTO DE CARBONO',11,1},
                {'B · SILICATO Y CRISTAL',34,1},
                {'C · MINERAL Y LINGOTE',11,24},
                {'D · MEZCLA CONDUCTIVA',34,24},
            }
            for _,entry in ipairs(legends) do
                local anchor=Instance.new('Part')
                anchor.Name='EtiquetaReceta';anchor.Size=Vector3.new(.2,.2,.2)
                anchor.Anchored=true;anchor.Transparency=1
                anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
                anchor.Position=session.origin+Vector3.new(entry[2]*Construction.CELL_SIZE,8,entry[3]*Construction.CELL_SIZE)
                anchor.Parent=folder
                local tag=Instance.new('BillboardGui')
                tag.Size=UDim2.fromOffset(240,39)
                tag.MaxDistance=160;tag.AlwaysOnTop=true;tag.Parent=anchor
                local text=Instance.new('TextLabel')
                text.Size=UDim2.fromScale(1,1)
                text.BackgroundColor3=Color3.fromRGB(20,34,45)
                text.TextColor3=Color3.fromRGB(88,232,231)
                text.Font=Enum.Font.GothamBold;text.TextScaled=true
                text.Text=entry[1];text.Parent=tag
            end
            local reply=packet(session)
            reply.ok=true;reply.code='demo_production'
            command:FireClient(player,reply)
            factoryUpdate:FireClient(player,Simulation.report(session))
            return
        end

        -- MEGA FÁBRICA 4.3. Diseño sobre 48x48 casillas, 2 alturas, sin colisiones.
