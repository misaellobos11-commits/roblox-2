            local staged=Construction.fromSnapshot(Construction.snapshot(session.state))
            local valid=true
            for _,entry in ipairs(demo) do
                local ok=Construction.apply(staged,player.UserId,{kind='place',machineType=entry.t,
                    x=entry.x,z=entry.z,rotation=entry.r,level=entry.level})
                if not ok then valid=false;break end
            end
            if not valid then
                local reply=packet(session)
                reply.ok=false;reply.code='demo_blocked'
                command:FireClient(player,reply)
                return
