				</Properties>
			</Item>
			<Item class="ModuleScript" referent="1005">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Etapa 4: simulación autoritativa de rutas y fabricación por recetas.
local Catalog=require(game:GetService('ReplicatedStorage').Shared.MachineCatalog)
local Visual=require(game:GetService('ReplicatedStorage').Shared.MachineVisual)
local Simulation={}
local Economy=require(game:GetService('ReplicatedStorage').Shared.Economy)
local PERIOD=.6
local function slot(session,id)
    if not session.runtime[id] then
        session.runtime[id]={input={},output={},last=0,alternate=false,totalMade=0,totalMoved=0,nextRoute=0}
    end
    return session.runtime[id]
end
function Simulation.newSession(session)
    session.runtime={};session.cash=Economy.startCash;session.sales=0;session.lifetimeRevenue=0;session.itemsSold={}
end
function Simulation.forget(session,id) session.runtime[id]=nil end
local function accept(session,target,item)
    local typ=target.machineType
    local r=slot(session,target.id)
    if typ=='Receiver' then return false end
    if typ=='Seller' then
        local d=Catalog.items[item]
        if not d then return false end
        session.cash+=d.value
        session.lifetimeRevenue=(session.lifetimeRevenue or 0)+d.value
        session.sales+=1
        session.itemsSold[item]=(session.itemsSold[item] or 0)+1
        return true
    end
    if Catalog.hasRecipes(typ) then
        local recipe=Catalog.recipeFor(target)
        if not recipe or not recipe.inputs[item] then return false end
        local total=0;local same=0
        for _,stored in ipairs(r.input) do
            total+=1
            if stored==item then same+=1 end
        end
        -- Reservar sitio para el SEGUNDO ingrediente (evita bloqueos por saturación).
        if total&gt;=12 or same&gt;=6 then return false end
        table.insert(r.input,item)
        return true
    end
    local capacity=if typ=='Storage' then 40 elseif Catalog.isTransport(typ) then 1 else 5
    if #r.output&gt;=capacity then return false end
    table.insert(r.output,item)
    return true
end
local function produceRecipe(rec,r,now)
    local recipe=Catalog.recipeFor(rec)
    if not recipe or now-r.last&lt;recipe.seconds then return end
    if #r.output&gt;=5 then return end
    local counts={}
    for _,item in ipairs(r.input) do counts[item]=(counts[item] or 0)+1 end
    for item,quantity in pairs(recipe.inputs) do
        if (counts[item] or 0)&lt;quantity then return end
    end
    -- Resolver insumos sin depender de su orden de llegada al único puerto trasero.
    local required=table.clone(recipe.inputs)
    for i=#r.input,1,-1 do
        local item=r.input[i]
        if (required[item] or 0)&gt;0 then
            table.remove(r.input,i)
            required[item]-=1
        end
    end
    if recipe.alternate then
        r.alternate=not r.alternate
        table.insert(r.output,if r.alternate then 'Carbon' else 'Oxygen')
    else
        for item,quantity in pairs(recipe.outputs) do
            for _=1,quantity do table.insert(r.output,item) end
        end
    end
    r.last=now
    r.totalMade+=1
end
function Simulation.tick(session)
    local now=os.clock()
    -- 1. Transformar materia. Solo se consumen entradas si la receta está completa.
    for id,record in pairs(session.state.buildings) do
        local r=slot(session,id)
        if record.machineType=='Receiver' then
            if #r.output&lt;5 and now-r.last&gt;=1.8 then
                table.insert(r.output,'RawMatter')
                r.last=now;r.totalMade+=1
            end
        elseif Catalog.hasRecipes(record.machineType) then
            produceRecipe(record,r,now)
        end
    end
    -- 2. Congelar emisores. Cada unidad avanza como máximo una conexión por tick.
    local movers={}
    for id,rec in pairs(session.state.buildings) do
        local r=slot(session,id)
        if #r.output&gt;0 then table.insert(movers,{source=rec,item=r.output[1]}) end
    end
    table.sort(movers,function(a,b) return a.source.id&gt;b.source.id end)
    for _,move in ipairs(movers) do
        local rec=move.source
        local r=slot(session,rec.id)
        if r.output[1]==move.item then
            local neighbors=Catalog.neighbors(session.state.buildings,rec)
            local routes=Catalog.routeOrder(rec,move.item,r.nextRoute)
            local delivered=false
            for _,route in ipairs(routes) do
                for _,target in ipairs(neighbors[route] or {}) do
                    if accept(session,target,move.item) then
                        table.remove(r.output,1);r.totalMoved+=1
                        if rec.machineType=='SplitterThree' then
                            local index=if route=='left' then 0 elseif route=='front' then 1 else 2
                            r.nextRoute=(index+1)%3
                        end
                        delivered=true
                        break
                    end
                end
                if delivered then break end
            end
        end
    end
    -- 3. Actualizar aspectos visibles e inventario para panel lateral.
    for id,rec in pairs(session.state.buildings) do
        local model=session.models[id]
        if model then
            local r=slot(session,id)
            model:SetAttribute('Inventory',#r.input+#r.output)
            model:SetAttribute('Produced',r.totalMade)
            if Catalog.isTransport(rec.machineType) then Visual.setCargo(model,r.output[1]) end
        end
    end
end
function Simulation.report(session)
    local summary={}
    for id,rec in pairs(session.state.buildings) do
        local r=slot(session,id)
        summary[tostring(id)]={inside=#r.input,output=#r.output,produced=r.totalMade,moved=r.totalMoved}
    end
    return {cash=session.cash,sales=session.sales,lifetimeRevenue=session.lifetimeRevenue or 0,techTier=Economy.tier(session.lifetimeRevenue or 0),nextThreshold=Economy.nextThreshold(session.lifetimeRevenue or 0),inventory=summary}
end
function Simulation.run(sessions,remote)
    task.spawn(function()
        local elapsed=0
        while true do
            local dt=task.wait(PERIOD)
            elapsed+=dt
            for player,session in pairs(sessions) do
                if player.Parent then
                    Simulation.tick(session)
                    if elapsed&gt;=1.2 then remote:FireClient(player,Simulation.report(session)) end
                end
            end
            if elapsed&gt;=1.2 then elapsed=0 end
        end
    end)
end
return Simulation
</ProtectedString>
