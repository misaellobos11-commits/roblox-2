			<Item class="ModuleScript" referent="RBXFEEF062215014EBAB4C45C8A9A1B02BE">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Matterloom 4.2: catálogo de procesadores especializados y conexiones validadas.
local C={}
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
C.types={
 Receiver={name='Receptor de materia',size=2,color=rgb(88,200,250),description='Genera materia base periódicamente.',group='Especial'},
 CarbonProcessor={name='Separador de carbono',size=2,color=rgb(108,115,131),description='Obtiene carbono de materia base.',group='Producción'},
 OxygenProcessor={name='Generador de oxígeno',size=2,color=rgb(86,199,236),description='Obtiene oxígeno de materia base.',group='Producción'},
 SiliconProcessor={name='Procesador de silicio',size=2,color=rgb(149,152,213),description='Separa silicio a partir de materia base.',group='Producción'},
 IronProcessor={name='Formador de hierro',size=2,color=rgb(146,165,181),description='Transforma materia base en hierro.',group='Producción'},
 CopperProcessor={name='Procesador de cobre',size=2,color=rgb(230,145,89),description='Separa cobre a partir de materia base.',group='Producción'},
 HydrogenProcessor={name='Generador de hidrógeno',size=2,color=rgb(199,224,238),description='Obtiene hidrógeno de materia base.',group='Producción'},
 FusionChamber={name='Cámara de fusión',size=2,color=rgb(244,149,71),description='Combina dos elementos en compuestos básicos.',group='Producción'},
 ElementSynthesizer={name='Sintetizador elemental',size=2,color=rgb(161,122,255),description='Sintetiza materiales metálicos y conductivos con dos elementos.',group='Producción'},
 Crystallizer={name='Cristalizador',size=2,color=rgb(104,224,255),description='Convierte silicato en cristales básicos.',group='Producción'},
 MineralFormer={name='Formador mineral',size=2,color=rgb(233,185,105),description='Compacta compuesto metálico para obtener mineral sintético.',group='Producción'},
 Smelter={name='Fundidora',size=2,color=rgb(255,132,77),description='Refina mineral sintético en lingotes.',group='Producción'},
 Storage={name='Almacén',size=2,color=rgb(151,175,238),description='Guarda hasta 40 materiales y los redistribuye.',group='Especial'},
 Seller={name='Terminal de venta',size=2,color=rgb(131,222,159),description='Vende los materiales que recibe.',group='Especial'},
 Belt={name='Transportador',size=1,color=rgb(235,188,90),description='Mueve productos en la dirección de sus flechas.',group='Transporte'},
 ElevatorUp={name='Ascensor hacia arriba',size=1,color=rgb(85,189,243),description='Sube un material del nivel 0 al nivel 1.',group='Transporte'},
 ElevatorDown={name='Ascensor hacia abajo',size=1,color=rgb(88,201,236),description='Baja un material del nivel 1 al nivel 0.',group='Transporte'},
 SplitterLeft={name='Divisor izquierdo',size=1,color=rgb(230,178,71),description='Prioriza izquierda; si se bloquea, intenta frente.',group='Transporte'},
 SplitterRight={name='Divisor derecho',size=1,color=rgb(230,178,71),description='Prioriza derecha; si se bloquea, intenta frente.',group='Transporte'},
 SplitterThree={name='Divisor de tres vías',size=1,color=rgb(247,205,100),description='Reparte entre izquierda, frente y derecha por turnos.',group='Transporte'},
 OverflowLeft={name='Desborde izquierdo',size=1,color=rgb(239,144,76),description='Sale al frente; si se bloquea, sale a la izquierda.',group='Transporte'},
 OverflowRight={name='Desborde derecho',size=1,color=rgb(239,144,76),description='Sale al frente; si se bloquea, sale a la derecha.',group='Transporte'},
 FilterLeft={name='Filtro izquierdo',size=1,color=rgb(119,228,155),description='Desvía a la izquierda solo el material configurado.',group='Transporte'},
 FilterRight={name='Filtro derecho',size=1,color=rgb(119,228,155),description='Desvía a la derecha solo el material configurado.',group='Transporte'},
}
C.order={'Receiver','Belt','ElevatorUp','ElevatorDown','SplitterLeft','SplitterRight','SplitterThree','OverflowLeft','OverflowRight','FilterLeft','FilterRight','CarbonProcessor','OxygenProcessor','SiliconProcessor','IronProcessor','CopperProcessor','HydrogenProcessor','FusionChamber','ElementSynthesizer','Crystallizer','MineralFormer','Smelter','Storage','Seller'}
C.items={
 RawMatter={name='Materia base',value=1,color=rgb(171,207,227)},
 Carbon={name='Carbono',value=8,color=rgb(105,111,129)},
 Oxygen={name='Oxígeno',value=10,color=rgb(111,216,255)},
 Silicon={name='Silicio',value=12,color=rgb(164,167,213)},
 Iron={name='Hierro',value=12,color=rgb(124,143,167)},
 Copper={name='Cobre',value=14,color=rgb(228,151,91)},
 Hydrogen={name='Hidrógeno',value=11,color=rgb(224,236,246)},
 CarbonCompound={name='Compuesto de carbono',value=24,color=rgb(90,98,120)},
 Silicate={name='Silicato',value=26,color=rgb(202,186,153)},
 BaseMetal={name='Compuesto metálico',value=30,color=rgb(165,162,180)},
 ConductiveMix={name='Mezcla conductiva',value=34,color=rgb(211,132,77)},
 BasicCrystal={name='Cristal básico',value=55,color=rgb(118,230,255)},
 SyntheticOre={name='Mineral sintético',value=62,color=rgb(157,166,190)},
 Ingot={name='Lingote',value=95,color=rgb(205,217,227)},
} 
C.filterOrder={'Carbon','Oxygen','RawMatter'}
C.details={
 Receiver={inputs={'Ninguna'},outputs={'Materia base ×1'},cycle='Cada 1,8 s',notes='Necesita salida libre.'},
 CarbonProcessor={inputs={'Materia base ×1'},outputs={'Carbono ×1'},cycle='Cada 2,0 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 OxygenProcessor={inputs={'Materia base ×1'},outputs={'Oxígeno ×1'},cycle='Cada 2,2 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 SiliconProcessor={inputs={'Materia base ×1'},outputs={'Silicio ×1'},cycle='Cada 2,6 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 IronProcessor={inputs={'Materia base ×1'},outputs={'Hierro ×1'},cycle='Cada 2,7 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 CopperProcessor={inputs={'Materia base ×1'},outputs={'Cobre ×1'},cycle='Cada 2,8 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 HydrogenProcessor={inputs={'Materia base ×1'},outputs={'Hidrógeno ×1'},cycle='Cada 2,5 s',notes='Producción fija. Para obtener otros elementos, coloca otra máquina.'},
 FusionChamber={inputs={'Carbono + Oxígeno o Silicio + Oxígeno'},outputs={'Compuesto de carbono o Silicato'},cycle='3 s',notes='G cambia entre las dos recetas.'},
 ElementSynthesizer={inputs={'Hierro + Carbono o Cobre + Silicio'},outputs={'Compuesto metálico o Mezcla conductiva'},cycle='3,2 s',notes='G cambia entre las dos recetas.'},
 Crystallizer={inputs={'Silicato ×1'},outputs={'Cristal básico ×1'},cycle='3,5 s',notes='Requiere un silicato por ciclo.'},
 MineralFormer={inputs={'Compuesto metálico ×1'},outputs={'Mineral sintético ×1'},cycle='3,5 s',notes='Compacta compuestos; no extrae minerales del suelo.'},
 Smelter={inputs={'Mineral sintético ×1'},outputs={'Lingote ×1'},cycle='4 s',notes='Etapa posterior a la síntesis de mineral.'},
 Storage={inputs={'Cualquier material'},outputs={'El mismo material'},cycle='Un envío por tick',notes='Capacidad: 40.'},
 Seller={inputs={'Cualquier material'},outputs={'Créditos'},cycle='Al recibir',notes='Materia $1 · Carbono $8 · Oxígeno $10.'},
 Belt={inputs={'Paquete desde atrás o un costado'},outputs={'Paquete hacia el frente'},cycle='Cada 0,6 s',notes='Permite curvas y arrastre continuo.'},
 ElevatorUp={inputs={'Paquete en nivel 0'},outputs={'Paquete en nivel 1'},cycle='Cada 0,6 s',notes='Coloca una cinta de nivel 1 al final.'},
 ElevatorDown={inputs={'Paquete en nivel 1'},outputs={'Paquete en nivel 0'},cycle='Cada 0,6 s',notes='Conecta una cinta elevada detrás.'},
 SplitterLeft={inputs={'Paquete desde atrás'},outputs={'Izquierda preferente; frente alternativo'},cycle='Cada 0,6 s',notes='Una sola copia del paquete.'},
 SplitterRight={inputs={'Paquete desde atrás'},outputs={'Derecha preferente; frente alternativo'},cycle='Cada 0,6 s',notes='Una sola copia del paquete.'},
 SplitterThree={inputs={'Paquete desde atrás'},outputs={'Izquierda / frente / derecha'},cycle='Cada 0,6 s',notes='Distribución circular entre salidas libres.'},
 OverflowLeft={inputs={'Paquete desde atrás'},outputs={'Frente; izquierda solo si está bloqueado'},cycle='Cada 0,6 s',notes='Desbordamiento condicionado por capacidad.'},
 OverflowRight={inputs={'Paquete desde atrás'},outputs={'Frente; derecha solo si está bloqueado'},cycle='Cada 0,6 s',notes='Desbordamiento condicionado por capacidad.'},
 FilterLeft={inputs={'Paquete desde atrás'},outputs={'Coincidencia: izquierda; resto: frente'},cycle='Cada 0,6 s',notes='Selecciona el material con F al elegir el filtro.'},
