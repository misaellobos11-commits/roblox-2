            local reply=packet(session)
            reply.ok=true;reply.code='demo_production'
            command:FireClient(player,reply)
            factoryUpdate:FireClient(player,Simulation.report(session))
            return
        end

        -- MEGA FÁBRICA 4.3. Diseño sobre 48x48 casillas, 2 alturas, sin colisiones.
        -- PREVISUALIZAR con la guía. Se requiere parcela vacía para proteger la fábrica personal.
        if order.kind=='demo_mega' then
            if Construction.count(session.state)&gt;0 then
                local reply=packet(session)
                reply.ok=false;reply.code='mega_requires_empty'
                command:FireClient(player,reply)
                return
            end
            local demo={
                {t='Receiver',x=2.0,z=3.0,r=3,recipeId=None,level=0},
