        end
        detail(model,'CubetaFusión',Vector3.new(3.45,.77,2.7),Vector3.new(0,4.19,.23),graphite)
        sphere(model,'Reacción',Vector3.new(0,4.86,.23),1.98,fusionOrange,Enum.Material.Neon)
        cylinder(model,'ReactorSuperior',Vector3.new(0,6.9,.23),.47,2.8,metal)
    elseif t=='ElementSynthesizer' then
        frame(model,3.15,6.45,violet)
        for _,x in {-2.15,2.15} do
            cylinder(model,'BobinaSíntesis',Vector3.new(x,4.70,0),2.05,1.14,Color3.fromRGB(101,84,154))
            glow(model,'Electrodo',Vector3.new(.30,.42,.40),Vector3.new(x,6.03,0),violet)
            rod(model,'Conexión', {x,5.2,0},{x*.36,5.6,0},.16,violet)
        end
        sphere(model,'OrbeSíntesis',Vector3.new(0,5.45,0),2.45,violet,Enum.Material.Glass)
        sphere(model,'NúcleoOrbe',Vector3.new(0,5.45,0),1.13,plasma,Enum.Material.Neon)
    elseif t=='Crystallizer' then
        frame(model,3.1,6.8,plasma)
        glass(model,'Vitrina',Vector3.new(4.1,3.2,3.55),Vector3.new(0,5.1,0),plasma,.60)
        for _,prism in ipairs({{-1.2,4.90,.2,.10},{0,5.35,.5,-.20},{1.1,5.0,-.7,.21}}) do
            local p=glass(model,'Cristal',Vector3.new(.85,2.30,.98),Vector3.new(prism[1],prism[2],prism[3]),Color3.fromRGB(96,224,255),.10)
            p.CFrame=p.CFrame*CFrame.Angles(prism[4],math.pi/4,math.pi/9)
        end
        glow(model,'BandaFría',Vector3.new(4.7,.18,3.6),Vector3.new(0,3.86,0),plasma)
    elseif t=='MineralFormer' then
        for _,x in {-2.35,2.35} do cornerColumn(model,x,0,5.12,3.1) end
        detail(model,'PuenteCompresión',Vector3.new(6.0,.66,3.65),Vector3.new(0,7.04,0),silver)
        cylinder(model,'PistónFormador',Vector3.new(0,5.65,0),1.66,1.35,metal)
        detail(model,'PrensaFormadora',Vector3.new(3.6,.83,3.2),Vector3.new(0,4.65,0),graphite)
        glow(model,'MaterialCompactado',Vector3.new(2.85,.22,2.1),Vector3.new(0,4.15,0),gold)
    elseif t=='Smelter' then
        detail(model,'HornoFundición',Vector3.new(5.2,3.52,4.45),Vector3.new(0,4.55,0),graphite)
        glow(model,'GargantaHorno',Vector3.new(3.3,1.52,.17),Vector3.new(0,4.45,2.28),fusionOrange)
        detail(model,'BocaHorno',Vector3.new(3.8,.40,.65),Vector3.new(0,3.65,2.32),metal)
        for _,x in {-1.8,1.8} do
            cylinder(model,'Chimenea',Vector3.new(x,7.25,-1.1),2.15,1.08,metal)
            glow(model,'SalidaCalor',Vector3.new(.63,.10,.63),Vector3.new(x,8.4,-1.1),fusionOrange)
        end
        for _,z in {-1.5,-.8,0} do vents(model,-2.64,5.3,z,silver) end
    elseif t=='Storage' then
        detail(model,'ArmarioAlmacén',Vector3.new(6.15,3.55,4.8),Vector3.new(0,4.35,0),graphite2)
        for _,x in {-1.55,1.55} do
            detail(model,'Puerta',Vector3.new(2.65,2.45,.27),Vector3.new(x,4.27,2.52),metal)
            glow(model,'IndicadorStock',Vector3.new(1.55,.18,.1),Vector3.new(x,5.13,2.72),plasma)
            for _,y in {3.75,4.20,4.65} do
                detail(model,'RejillaAlmacén',Vector3.new(1.6,.10,.09),Vector3.new(x,y,2.72),graphite)
            end
        end
    elseif t=='Seller' then
        detail(model,'BaseTerminal',Vector3.new(5.15,2.25,3.35),Vector3.new(0,4.18,0),graphite)
        detail(model,'PantallaVenta',Vector3.new(4.0,2.85,.50),Vector3.new(0,6.02,-.95),metal)
        glow(model,'DisplayCréditos',Vector3.new(3.20,2.12,.13),Vector3.new(0,6.05,-1.23),lime)
        for _,x in {-1.12,1.12} do
            glow(model,'Billete',Vector3.new(.56,.13,.18),Vector3.new(x,6.05,-1.37),graphite)
        end
        detail(model,'EscánerEntrada',Vector3.new(2.7,.35,1.25),Vector3.new(0,4.3,2.24),graphite)
        glow(model,'LectorVenta',Vector3.new(2.3,.1,.25),Vector3.new(0,4.60,2.23),lime)
    end
    makePorts(model,rec)
end
function Visual.create(parent,record,origin,preview)
    local data=Catalog.types[record.machineType]
    assert(data,'Tipo de máquina desconocido')
    local model=Instance.new('Model')
    model.Name=if preview then 'BuildPreview' else record.machineType..'_'..record.id
    model:SetAttribute('BuildingId',record.id)
    model:SetAttribute('MachineType',record.machineType)
    local anchor=block(model,'Anchor',Vector3.new(.1,.1,.1),Vector3.zero,dark)
    anchor.Transparency=1;anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
    model.PrimaryPart=anchor
    -- Blender visual is inserted at logical (0,0,0), so rotation and position
    -- remain identical to the original machines. Server production is unchanged.
    local key=visualKeys[record.machineType]
    if key and installBlenderAsset(model,key) then
        importedLabel(model,record,anchor)
        Visual.pivot(model,record,origin)
        if record.machineType=='Belt' then Visual.setBeltIncoming(model,nil) end
        model.Parent=parent
        return model
    end
    local width=data.size*Construction.CELL_SIZE
    local foundation=block(model,'Base',Vector3.new(width-.14,.42,width-.14),Vector3.new(0,.22,0),graphite)
    foundation.TopSurface=Enum.SurfaceType.Smooth
    if Catalog.isTransport(record.machineType) then
        styleTransport(model,record,data,anchor)
    else
        styleProcessor(model,record,data)
        label(anchor,'Etiqueta',data.name:upper(),if record.machineType=='Seller' then 9 else 8.8)
    end
    if preview then
        for _,item in ipairs(model:GetDescendants()) do
            if item:IsA('BasePart') then
                item.CanCollide=false
                item.CanTouch=false
                item.CanQuery=false
            end
        end
    end
    Visual.pivot(model,record,origin)
    if record.machineType=='Belt' then Visual.setBeltIncoming(model,nil) end
    model.Parent=parent
    return model
end

function Visual.setPreview(model,valid)
    local color=if valid then Color3.fromRGB(75,231,171) else Color3.fromRGB(255,97,106)
    for _,item in ipairs(model:GetDescendants()) do
        if item:IsA('BasePart') and item.Name~='Anchor' then
            item.Color=if item.Name=='TrazoCinta' or item.Name=='Flecha' or item.Name=='EntradaCompacta' or item.Name=='EntradaNaranja' or item.Name=='SalidaCian' then orange else color
            item.Transparency=if item.Name=='TrazoCinta' then .12 else .48
        end
    end
end
function Visual.setCargo(model,item)
    if not model or not model.PrimaryPart then return end
    local existing=model:FindFirstChild('Producto')
    if not item then
        if existing then existing:Destroy() end
        return
    end
    if existing and existing:GetAttribute('ItemType')==item then return end
    if existing then existing:Destroy() end
    local data=Catalog.items[item]
    if not data then return end
    local cube=block(model,'Producto',Vector3.new(1.1,1.05,1.1),Vector3.zero,data.color,Enum.Material.Neon)
    cube.CanCollide=false
    cube.CanTouch=false
    cube.CanQuery=false
    cube:SetAttribute('ItemType',item)
    local root=model.PrimaryPart.CFrame
    local machineType=model:GetAttribute('MachineType')
    if machineType=='ElevatorUp' or machineType=='ElevatorDown' then
        local goingUp=machineType=='ElevatorUp'
        cube.CFrame=root*CFrame.new(0,if goingUp then 1.3 else 8.55,0)
        TweenService:Create(cube,TweenInfo.new(.48,Enum.EasingStyle.Linear),{
            CFrame=root*CFrame.new(0,if goingUp then 8.55 else 1.3,0)
        }):Play()
        return
    end
    local incomingX=if machineType=='Belt' then (model:GetAttribute('CornerFromX') or 0) else 0
    if incomingX~=0 then
        cube.CFrame=root*CFrame.new(incomingX*1.05,1.24,0)
        local first=TweenService:Create(cube,TweenInfo.new(.22,Enum.EasingStyle.Linear),
            {CFrame=root*CFrame.new(0,1.24,0)})
        first.Completed:Connect(function()
            if cube.Parent then
                TweenService:Create(cube,TweenInfo.new(.23,Enum.EasingStyle.Linear),
                    {CFrame=root*CFrame.new(0,1.24,.95)}):Play()
            end
        end)
        first:Play()
    else
        cube.CFrame=root*CFrame.new(0,1.24,-.95)
        TweenService:Create(cube,TweenInfo.new(.45,Enum.EasingStyle.Linear),
            {CFrame=root*CFrame.new(0,1.24,.95)}):Play()
    end
end
return Visual
