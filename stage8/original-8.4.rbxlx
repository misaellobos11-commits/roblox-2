			<Item class="ModuleScript" referent="1002">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Genera el entorno entero con Parts: no requiere Toolbox ni modelos externos.
local Lighting = game:GetService('Lighting')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local MapConfig = require(ReplicatedStorage:WaitForChild('Shared'):WaitForChild('MapConfig'))
local MapGenerator = {}
local rng = Random.new(42026)

local C = {
    earth = Color3.fromRGB(94, 75, 68),
    earthLight = Color3.fromRGB(120, 90, 72),
    clay = Color3.fromRGB(80, 65, 62),
    grass = Color3.fromRGB(70, 80, 66),
    grassAlt = Color3.fromRGB(82, 89, 72),
    concrete = Color3.fromRGB(102, 112, 119),
    rock = Color3.fromRGB(86, 89, 91),
    rockAlt = Color3.fromRGB(115, 112, 110),
    tree = Color3.fromRGB(70, 54, 47),
    leaf = Color3.fromRGB(65, 78, 64),
    leafAlt = Color3.fromRGB(93, 84, 66),
    metal = Color3.fromRGB(33, 47, 56),
    cyan = Color3.fromRGB(65, 205, 216),
    white = Color3.fromRGB(218, 223, 219),
}

local function part(parent, name, size, pos, color, material, shape)
    local p = Instance.new('Part')
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.Position = pos
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    if shape then p.Shape = shape end
    p.Parent = parent
    return p
end
local function trim(parent, position, size)
    local p = part(parent, 'LuzCian', size, position, C.cyan, Enum.Material.Neon)
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    return p
end

local function neonPost(parent, x, z, height)
    local h = height or 6
    part(parent,'Poste',Vector3.new(1.2,h,1.2),Vector3.new(x,h/2 - .2,z),C.metal,Enum.Material.Metal)
    local lamp = trim(parent,Vector3.new(x,h-.2,z),Vector3.new(1.8,.5,1.8))
    local light = Instance.new('PointLight')
    light.Color = C.cyan
    light.Brightness = .75
    light.Range = 13
    light.Parent = lamp
end

local function path(parent, a, b, width)
    local start = Vector3.new(a.X,-.62,a.Z)
    local finish = Vector3.new(b.X,-.62,b.Z)
    local diff = finish-start
    local p = part(parent,'Sendero',Vector3.new(width,.45,diff.Magnitude),start+diff/2,C.clay,Enum.Material.Ground)
    p.CFrame = CFrame.lookAt(start+diff/2,finish)
    return p
end

local function makePlaza(parent)
    local platform = part(parent,'PlazaCircular',Vector3.new(5,102,102),Vector3.new(0,-2.5,0),C.concrete,Enum.Material.Concrete,Enum.PartType.Cylinder)
    -- Cylinder axis is its local X; rotate so the circular surface faces up.
    platform.CFrame = CFrame.new(0,-2.5,0) * CFrame.Angles(0,0,math.rad(90))
    local center = part(parent,'Centro',Vector3.new(.5,54,54),Vector3.new(0,.1,0),C.metal,Enum.Material.Metal,Enum.PartType.Cylinder)
    center.CFrame = CFrame.new(0,.1,0) * CFrame.Angles(0,0,math.rad(90))
    -- Neon pads, replacing expensive meshes / image assets.
    for i=1,24 do
        local angle = 2*math.pi*i/24
        local angle2 = 2*math.pi*(i+0.8)/24
        local r = 34
        local a = Vector3.new(math.cos(angle)*r,.45,math.sin(angle)*r)
        local b = Vector3.new(math.cos(angle2)*r,.45,math.sin(angle2)*r)
        local beam = trim(parent,(a+b)*.5,Vector3.new(.55,.22,(a-b).Magnitude))
        beam.CFrame = CFrame.lookAt((a+b)*.5,b)
    end
    local terminal = part(parent,'TerminalCentral',Vector3.new(14,6,3),Vector3.new(0,4,0),C.metal,Enum.Material.Metal)
    local gui = Instance.new('BillboardGui')
    gui.Name='NombreDelJuego'
    gui.AlwaysOnTop=true
    gui.Size=UDim2.fromOffset(330,100)
    gui.StudsOffsetWorldSpace=Vector3.new(0,6,0)
    gui.MaxDistance=190
    gui.Parent=terminal
    local txt=Instance.new('TextLabel')
    txt.Size=UDim2.fromScale(1,1)
    txt.BackgroundColor3=C.metal
    txt.BackgroundTransparency=.12
    txt.Font=Enum.Font.GothamBold
    txt.Text='MATTERLOOM\nCENTRO DE SÍNTESIS'
    txt.TextColor3=C.cyan
    txt.TextSize=24
    txt.Parent=gui
    local corner=Instance.new('UICorner')
    corner.CornerRadius=UDim.new(0,8)
    corner.Parent=txt
    for i=1,8 do
        local a=math.pi*2*i/8
        neonPost(parent,math.cos(a)*44,math.sin(a)*44,5)
    end
    -- Único SpawnLocation neutral; las parcelas usan EntrySpawn como partes normales.
    local spawn=Instance.new('SpawnLocation')
    spawn.Name='MatterloomLobbySpawn'
    spawn.Anchored=true
    spawn.Neutral=true
    spawn.Duration=0
    spawn.Size=Vector3.new(10,.7,10)
    spawn.Position=Vector3.new(0,.75,23)
    spawn.Material=Enum.Material.Metal
    spawn.Color=C.concrete
    spawn.Parent=parent
    trim(parent,Vector3.new(0,1.12,23),Vector3.new(10,.14,1))
    return spawn
end

local function inPlot(x,z,padding)
    local distance = MapConfig.PLOT_SIZE*.5+(padding or 0)
    for i=1,MapConfig.MAX_PLOTS do
        local center=MapConfig.plotCenter(i)
        if math.abs(x-center.X)&lt;distance and math.abs(z-center.Z)&lt;distance then return true end
    end
    return false
end
local function nearRoad(x,z)
    -- Mantener despejado el eje central y las entradas a cada parcela.
    if math.abs(z)&lt;53 and math.abs(x)&lt;480 then return true end
    for _,cx in MapConfig.PLOT_CENTERS_X do
        if math.abs(x-cx)&lt;15 and math.abs(z)&lt;175 then return true end
    end
    if x*x+z*z&lt;68*68 then return true end
    return false
end

local function tree(parent,x,z)
    local h = rng:NextNumber(19,37)
    local t = part(parent,'Tronco',Vector3.new(3.3,h,3.3),Vector3.new(x,(h/2)-.8,z),C.tree,Enum.Material.Wood)
    t.Orientation=Vector3.new(0,rng:NextInteger(0,360),rng:NextNumber(-2,2))
    for j=1,3 do
        local sy = h*.54 + j*h*.11
        local radius = if j==1 then 14 else if j==2 then 12 else 9
        local shade=if rng:NextNumber()&gt;.68 then C.leafAlt else C.leaf
        local b=part(parent,'Copa',Vector3.new(radius,rng:NextNumber(4,7),radius),Vector3.new(x+rng:NextNumber(-2,2),sy,z+rng:NextNumber(-2,2)),shade,Enum.Material.Grass,Enum.PartType.Ball)
        b.CanCollide=false
        b.CanTouch=false
    end
end
local function boulder(parent,x,z)
    local w=rng:NextNumber(3,11)
    local p=part(parent,'Roca',Vector3.new(w,rng:NextNumber(2,5),w*rng:NextNumber(.8,1.2)),Vector3.new(x,.15,z),if rng:NextNumber()&gt;.5 then C.rock else C.rockAlt,Enum.Material.Slate,Enum.PartType.Ball)
    p.Orientation=Vector3.new(rng:NextNumber(-20,20),rng:NextNumber(0,180),rng:NextNumber(-15,15))
end

local function lighting()
    Lighting.ClockTime = 16.8
    Lighting.Brightness = 2
    Lighting.Ambient = Color3.fromRGB(85,91,99)
    Lighting.OutdoorAmbient = Color3.fromRGB(117,110,104)
    Lighting.FogColor = Color3.fromRGB(161,152,142)
    Lighting.FogEnd = 1050
    Lighting.GlobalShadows = true
    for _,item in Lighting:GetChildren() do
        if item.Name=='MatterloomAtmosphere' or item.Name=='MatterloomColors' or item.Name=='MatterloomBloom' then item:Destroy() end
    end
    local atmosphere = Instance.new('Atmosphere')
    atmosphere.Name = 'MatterloomAtmosphere'
    atmosphere.Density = .2
    atmosphere.Offset = .23
    atmosphere.Color = Color3.fromRGB(190,177,166)
    atmosphere.Decay = Color3.fromRGB(100,117,124)
    atmosphere.Glare = .08
    atmosphere.Haze = .9
    atmosphere.Parent = Lighting
    local correction=Instance.new('ColorCorrectionEffect')
    correction.Name='MatterloomColors'
    correction.Saturation=-.18
    correction.Contrast=.06
    correction.TintColor=Color3.fromRGB(255,245,234)
    correction.Parent=Lighting
    local bloom=Instance.new('BloomEffect')
    bloom.Name='MatterloomBloom'
    bloom.Intensity=.17
    bloom.Threshold=1.35
    bloom.Size=20
    bloom.Parent=Lighting
end

function MapGenerator.build()
    local previous=workspace:FindFirstChild('MatterloomWorld')
    if previous then previous:Destroy() end
    lighting()
    local world=Instance.new('Model')
    world.Name='MatterloomWorld'
    world.Parent=workspace
    local environment=Instance.new('Folder')
    environment.Name='BosqueIndustrial'
    environment.Parent=world
    part(environment,'Suelo',Vector3.new(1100,10,870),Vector3.new(0,-6,0),C.earth,Enum.Material.Ground)
    for i=1,60 do
        local x=rng:NextNumber(-525,525)
        local z=rng:NextNumber(-416,416)
        if not inPlot(x,z,14) and not nearRoad(x,z) then
            local width=rng:NextNumber(9,33)
            local patch=part(environment,'PastoSeco',Vector3.new(width,.14,width*.7),Vector3.new(x,-.94,z),if i%3==0 then C.grassAlt else C.grass,Enum.Material.Grass)
            patch.Orientation=Vector3.new(0,rng:NextNumber(0,180),0)
            patch.CanCollide=false
            patch.CanQuery=false
        end
    end
    local roads=Instance.new('Folder')
    roads.Name='Caminos'
    roads.Parent=world
    path(roads,Vector3.new(-460,0,0),Vector3.new(460,0,0),20)
    for slot=1,MapConfig.MAX_PLOTS do
        local point=MapConfig.entryPoint(slot)
        local side=if slot&lt;=4 then -1 else 1
        path(roads,point,Vector3.new(point.X,0,side*42),18)
        neonPost(roads,point.X-12,point.Z,6)
        neonPost(roads,point.X+12,point.Z,6)
    end
    local deco=Instance.new('Folder')
    deco.Name='ArbolesYRocas'
    deco.Parent=world
    for i=1,72 do
        local x=rng:NextNumber(-520,520)
        local z=rng:NextNumber(-405,405)
        if not inPlot(x,z,23) and not nearRoad(x,z) then tree(deco,x,z) end
    end
    for i=1,125 do
        local x=rng:NextNumber(-530,530)
        local z=rng:NextNumber(-415,415)
        if not inPlot(x,z,9) and not nearRoad(x,z) then boulder(deco,x,z) end
    end
    local hub=Instance.new('Folder')
    hub.Name='PlazaCentral'
    hub.Parent=world
    return makePlaza(hub)
end

return MapGenerator
</ProtectedString>
					<string name="ScriptGuid">{5FFF50C8-00B0-4EE3-9315-7D82F4A7BE17}</string>
