                {t='CopperProcessor',x=40,z=16,r=0,level=0},
                {t='Belt',x=40.5,z=18,r=0,level=0},
                {t='SplitterRight',x=40.5,z=19,r=0,level=0},
                {t='Belt',x=40.5,z=20,r=0,level=0},
                {t='Belt',x=40.5,z=21,r=0,level=0},
                {t='Storage',x=40,z=22,r=0,level=0},
                {t='Belt',x=41.5,z=19,r=3,level=0},
                {t='Belt',x=42.5,z=19,r=0,level=0},
                {t='Belt',x=42.5,z=20,r=0,level=0},
                {t='Belt',x=42.5,z=21,r=0,level=0},
                {t='Seller',x=42,z=22,r=0,level=0},
                {t='Receiver',x=5,z=39,r=0,level=0},
                {t='Belt',x=5.5,z=41,r=0,level=0},
                {t='FilterLeft',x=5.5,z=42,r=0,level=0,filterItem='RawMatter'},
                {t='Belt',x=5.5,z=43,r=0,level=0},
                {t='Belt',x=5.5,z=44,r=0,level=0},
                {t='Seller',x=5,z=45,r=0,level=0},
                {t='Belt',x=4.5,z=42,r=1,level=0},
                {t='Belt',x=3.5,z=42,r=0,level=0},
                {t='Belt',x=3.5,z=43,r=0,level=0},
                {t='Belt',x=3.5,z=44,r=0,level=0},
                {t='Seller',x=3,z=45,r=0,level=0},
                {t='Receiver',x=17,z=39,r=0,level=0},
                {t='Belt',x=17.5,z=41,r=0,level=0},
                {t='OverflowRight',x=17.5,z=42,r=0,level=0},
                {t='Belt',x=17.5,z=43,r=0,level=0},
                {t='Belt',x=17.5,z=44,r=0,level=0},
                {t='Storage',x=17,z=45,r=0,level=0,blocked=true},
                {t='Belt',x=18.5,z=42,r=3,level=0},
                {t='Belt',x=19.5,z=42,r=0,level=0},
                {t='Belt',x=19.5,z=43,r=0,level=0},
                {t='Belt',x=19.5,z=44,r=0,level=0},
                {t='Seller',x=19,z=45,r=0,level=0},
                {t='Receiver',x=29,z=39,r=0,level=0},
                {t='Belt',x=29.5,z=41,r=0,level=0},
                {t='SplitterLeft',x=29.5,z=42,r=0,level=0},
                {t='Belt',x=29.5,z=43,r=0,level=0},
                {t='Belt',x=29.5,z=44,r=0,level=0},
                {t='Seller',x=29,z=45,r=0,level=0},
                {t='Belt',x=28.5,z=42,r=1,level=0},
                {t='Belt',x=27.5,z=42,r=0,level=0},
                {t='Belt',x=27.5,z=43,r=0,level=0},
                {t='Belt',x=27.5,z=44,r=0,level=0},
                {t='Seller',x=27,z=45,r=0,level=0},
                {t='Receiver',x=42,z=34,r=0,level=0},
                {t='Belt',x=42.5,z=36,r=0,level=0},
                {t='ElevatorUp',x=42.5,z=37,r=0,level=0},
                {t='Belt',x=42.5,z=38,r=0,level=1},
                {t='Belt',x=42.5,z=39,r=0,level=1},
                {t='Belt',x=42.5,z=40,r=0,level=1},
                {t='Belt',x=42.5,z=41,r=0,level=1},
                {t='Belt',x=42.5,z=42,r=0,level=1},
                {t='ElevatorDown',x=42.5,z=43,r=0,level=0},
                {t='Belt',x=42.5,z=44,r=0,level=0},
                {t='Seller',x=42,z=45,r=0,level=0},
            }
            -- Etapa 1: validar todo en una copia, sin efectos secundarios.
            local staged=Construction.fromSnapshot(Construction.snapshot(session.state))
            local createdIds={}
            for _,entry in ipairs(demo) do
                local good,errorCode,newId=Construction.apply(staged,player.UserId,{
                    kind='place',machineType=entry.t,x=entry.x,z=entry.z,
                    rotation=entry.r,level=entry.level
                })
                if good then table.insert(createdIds,newId) end
                if not good then
                    local reply=packet(session)
                    reply.ok=false;reply.code='mega_blocked'
                    reply.detail=errorCode
                    command:FireClient(player,reply)
                    return
                end
            end
            -- Etapa 2: guardar toda la configuración antes de generar modelos 3D.
            session.state=staged
            local created={}
            for i,entry in ipairs(demo) do
                local record=session.state.buildings[createdIds[i]]
                -- Se reutilizan los IDs validados aunque el jugador haya borrado una fábrica anterior.
                if record then
                    if entry.recipeId then
                        Construction.apply(session.state,player.UserId,{
                            kind='configure_recipe',id=record.id,recipeId=entry.recipeId})
                    end
                    if entry.filterItem then
                        Construction.apply(session.state,player.UserId,{
                            kind='configure_filter',id=record.id,item=entry.filterItem})
                    end
                    if entry.blocked then
                        local full={input={},output={},last=0,alternate=false,totalMade=0,totalMoved=0,nextRoute=0}
                        for n=1,40 do table.insert(full.output,'RawMatter') end
                        session.runtime[record.id]=full
                    end
                    table.insert(created,record)
                end
            end
            for index,record in ipairs(created) do
                if index%20==0 then task.wait() end
                local model=Visual.create(session.machines,record,session.origin,false)
                model:SetAttribute('OwnerUserId',player.UserId)
                session.models[record.id]=model
            end
            redrawBelts(session)
            local labels={
                {'A / CARBONO + OXÍGENO',11,1},
                {'B / SILICATO + CRISTAL',34,1},
                {'C / MINERAL + LINGOTE',11,25},
                {'D / MEZCLA CONDUCTIVA',34,25},
                {'E / FILTRO DE CARBONO',5,12},
                {'F / TRES VÍAS + HIDRÓGENO',17,12},
                {'G / DESBORDE IZQUIERDO',29,12},
                {'H / DIVISOR + ALMACÉN',41,12},
                {'I / FILTRO IZQUIERDO',6,38},
                {'J / DESBORDE DERECHO',18,38},
                {'K / DIVISOR IZQUIERDO',30,38},
                {'L / PUENTE DE DOS ALTURAS',43,33},
            }
            local folder=Instance.new('Folder')
            folder.Name='MegaDemoLabels'
            folder.Parent=session.machines
            for _,entry in ipairs(labels) do
                local anchor=Instance.new('Part')
                anchor.Name='SeccionDemo'
                anchor.Size=Vector3.new(.2,.2,.2)
                anchor.Anchored=true;anchor.Transparency=1
                anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
                anchor.Position=session.origin+Vector3.new(entry[2]*Construction.CELL_SIZE,11,entry[3]*Construction.CELL_SIZE)
                anchor.Parent=folder
                local tag=Instance.new('BillboardGui')
                tag.Size=UDim2.fromOffset(225,37)
                tag.MaxDistance=105
                tag.AlwaysOnTop=true
                tag.Parent=anchor
                local text=Instance.new('TextLabel')
                text.Size=UDim2.fromScale(1,1)
                text.BackgroundColor3=Color3.fromRGB(18,33,45)
                text.TextColor3=Color3.fromRGB(92,228,230)
                text.Font=Enum.Font.GothamBold
                text.TextScaled=true
                text.Text=entry[1]
                text.Parent=tag
            end
            local reply=packet(session)
            reply.ok=true;reply.code='demo_mega'
            command:FireClient(player,reply)
            factoryUpdate:FireClient(player,Simulation.report(session))
            return
        end
        if order.kind=='place_many' then
            local amount=if type(order.placements)=='table' then #order.placements else 0
            -- Máximo de 64, validado también en Construction.applyMany.
            local cost=amount*(Economy.price('Belt') or 0)
            if amount&gt;=1 and amount&lt;=64 and session.cash&lt;cost then
                local response=packet(session);response.ok=false;response.code='insufficient_funds'
                command:FireClient(player,response)
                return
            end
            local ok,code,ids=Construction.applyMany(session.state,player.UserId,order.placements)
            if ok then session.cash-=cost end
            if ok then
                for _,id in ipairs(ids) do
                    local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                    model:SetAttribute('OwnerUserId',player.UserId)
                    session.models[id]=model
                end
                redrawBelts(session)
            end
            local response=packet(session)
            response.ok=ok
            response.code=code
            response.placed=if ok then #ids else 0
            command:FireClient(player,response)
            if ok then factoryUpdate:FireClient(player,Simulation.report(session)) end
            return
        end
        -- Verificación autoritativa del precio y la tecnología antes de construir.
        -- Los movimientos y cambios de receta siguen siendo gratuitos.
        local buyType=if order.kind=='place' then order.machineType else nil
        local cost=if type(buyType)=='string' then Economy.price(buyType) else nil
        if cost~=nil then
            local code=nil
            if not Economy.unlocked(buyType,session.lifetimeRevenue or 0) then
                code='tech_locked'
            elseif session.cash&lt;cost then
                code='insufficient_funds'
            end
            if code then
                local response=packet(session);response.ok=false;response.code=code
                command:FireClient(player,response)
                return
            end
        end
        local ok,code,id=Construction.apply(session.state,player.UserId,order)
        if ok then
            if cost~=nil and order.kind=='place' then session.cash-=cost end
            if order.kind=='remove' or order.kind=='remove_many' then
                local list=if order.kind=='remove_many' then id else {id}
                for _,removedId in ipairs(list) do
                    local model=session.models[removedId]
                    if model then model:Destroy() end
                    session.models[removedId]=nil
                    Simulation.forget(session,removedId)
                end
            elseif order.kind=='configure_recipe' then
                -- Cambiar receta descarta las entradas y salidas de la receta previa.
                Simulation.forget(session,id)
                local model=session.models[id]
                if model then model:SetAttribute('RecipeId',session.state.buildings[id].recipeId) end
            elseif order.kind=='configure_filter' then
                local model=session.models[id]
                if model then model:SetAttribute('FilterItem',session.state.buildings[id].filterItem) end
            elseif order.kind=='move' then
                local model=session.models[id]
                if model then
                    Visual.setCargo(model,nil)
                    Visual.pivot(model,session.state.buildings[id],session.origin)
                end
                Simulation.forget(session,id)
            else
                local model=Visual.create(session.machines,session.state.buildings[id],session.origin,false)
                model:SetAttribute('OwnerUserId',player.UserId)
                session.models[id]=model
            end
        end
        if ok then redrawBelts(session) end
        local response=packet(session)
        response.ok=ok
        response.code=code
        response.id=id
        command:FireClient(player,response)
        if ok then factoryUpdate:FireClient(player,Simulation.report(session)) end
    end)
    Players.PlayerAdded:Connect(function(player)
        player.RespawnLocation=lobbySpawn
        player.CharacterAdded:Connect(function(character)
            local session=sessions[player]
            if session then task.spawn(moveCharacter,player,character,session) end
        end)
    end)
    Players.PlayerRemoving:Connect(function(player)
        local session=sessions[player]
        if not session then return end
        sessions[player]=nil
        slots[session.slot]=nil
        for _,model in pairs(session.models) do model:Destroy() end
        local labels=session.machines:FindFirstChild('DemoLabels')
        if labels then labels:Destroy() end
        local recipes=session.machines:FindFirstChild('ProductionDemoLabels')
        if recipes then recipes:Destroy() end
        local megaLabels=session.machines:FindFirstChild('MegaDemoLabels')
        if megaLabels then megaLabels:Destroy() end
        session.models={}
        setPlotOwner(plotInfo[session.slot],nil)
        changed:FireAllClients(availablePlots())
    end)
    for _,player in Players:GetPlayers() do
        player.RespawnLocation=lobbySpawn
        player.CharacterAdded:Connect(function(character)
            local session=sessions[player]
            if session then task.spawn(moveCharacter,player,character,session) end
        end)
    end
    -- Exponer remotos cuando los controladores de servidor ya estén conectados.
    remotes.Parent=ReplicatedStorage
    Simulation.run(sessions,factoryUpdate)
end

return BuildServer
</ProtectedString>
					<string name="ScriptGuid">{6F12E305-5922-4687-A491-78C15705AD95}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">BuildServer</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">558304b3c8ae25c20aedcdde000003e5</UniqueId>
				</Properties>
