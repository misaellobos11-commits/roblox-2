            glow(model,'LuzProcesador',Vector3.new(.17,1.45,.09),Vector3.new(x,4.6,-.82),accent)
        end
    elseif t=='IronProcessor' then
        for _,x in {-2,2} do cornerColumn(model,x,0,5.02,2.75) end
        detail(model,'PuentePrensa',Vector3.new(5.3,.55,3.0),Vector3.new(0,6.7,0),metal)
        cylinder(model,'Pistón',Vector3.new(0,5.55,0),1.6,1.1,silver)
        detail(model,'Cabezal',Vector3.new(2.9,.72,2.2),Vector3.new(0,4.66,0),graphite)
        glow(model,'MetalEnProceso',Vector3.new(2.55,.22,1.38),Vector3.new(0,4.14,0),fusionOrange)
    elseif t=='CopperProcessor' then
        for _,x in {-1.75,1.75} do
            cylinder(model,'Bobinado',Vector3.new(x,4.77,0),.48,2.25,Color3.fromRGB(178,104,62),Enum.Material.Metal)
            for _,y in {4.25,4.67,5.09} do
                detail(model,'VueltaCobre',Vector3.new(.85,.12,2.35),Vector3.new(x,y,0),Color3.fromRGB(239,145,75))
            end
        end
        detail(model,'Mandril',Vector3.new(2.0,1.2,1.55),Vector3.new(0,4.5,0),graphite)
        glow(model,'SensorCobre',Vector3.new(1.12,.24,.7),Vector3.new(0,5.21,0),fusionOrange)
    elseif t=='HydrogenProcessor' then
        for _,x in {-1.7,1.7} do
            cylinder(model,'TanqueHidrógeno',Vector3.new(x,4.90,0),3.15,2.2,Color3.fromRGB(173,202,217))
            glass(model,'MirillaH2',Vector3.new(1.0,1.2,.15),Vector3.new(x,5.05,-1.13),plasma,.12)
            detail(model,'Llave',Vector3.new(.85,.35,.55),Vector3.new(x,6.63,0),metal)
        end
        rod(model,'ColectorH2',{-1.7,3.95,1.3},{1.7,3.95,1.3},.20,plasma)
