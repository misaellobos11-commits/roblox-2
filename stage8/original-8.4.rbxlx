					<ProtectedString name="Source">--!strict
-- Coordenadas compartidas entre el generador del mapa y el servidor.
local MapConfig = {}
MapConfig.PLOT_SIZE = 192
MapConfig.MAX_PLOTS = 8
MapConfig.PLOT_CENTERS_X = {-360, -120, 120, 360}
MapConfig.PLOT_CENTERS_Z = {-260, 260}
MapConfig.PLAZA_CENTER = Vector3.new(0, 0, 0)

function MapConfig.plotCenter(slot: number): Vector3
    assert(slot &gt;= 1 and slot &lt;= MapConfig.MAX_PLOTS, 'Parcela fuera de rango')
    local column = ((slot - 1) % 4) + 1
    local row = math.floor((slot - 1) / 4) + 1
    return Vector3.new(MapConfig.PLOT_CENTERS_X[column], 0, MapConfig.PLOT_CENTERS_Z[row])
end

function MapConfig.plotOrigin(slot: number): Vector3
    return MapConfig.plotCenter(slot) - Vector3.new(MapConfig.PLOT_SIZE / 2, 0, MapConfig.PLOT_SIZE / 2)
end

function MapConfig.entryPoint(slot: number): Vector3
    local center = MapConfig.plotCenter(slot)
    local towardCenter = if slot &lt;= 4 then 1 else -1
    return center + Vector3.new(0, 0, towardCenter * (MapConfig.PLOT_SIZE / 2 + 13))
end

return MapConfig
</ProtectedString>
