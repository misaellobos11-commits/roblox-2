				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Reglas autoritativas de construcción. Ninguna orden del cliente se confía sin comprobar.
local Catalog = require(script.Parent.MachineCatalog)
local Construction = {}
Construction.GRID_SIZE=48
Construction.CELL_SIZE=4
Construction.MAX_MACHINES=280
Construction.MAX_PLOTS=8
Construction.MACHINE_SIZE=2
Construction.messages = {
    placed='Máquina colocada. Conecta sus puertos para iniciar la producción.',
    moved='Máquina movida. Su contenido se reinició.',
    removed='Máquina retirada.',
    removed_many='Se retiraron las estructuras seleccionadas.',
    placed_many='Cintas construidas en cadena.',
    configured='Filtro configurado.',
    configured_recipe='Receta seleccionada. Se reinició el contenido de la máquina.',
    demo_production='Demo de producción creada.',
    outside='Debe estar dentro de tu parcela.',
    occupied='Esas casillas ya están ocupadas.',
    limit='Alcanzaste el máximo de 280 estructuras.',
    not_owner='Solo puedes construir en tu parcela.',
    not_found='La estructura ya no existe.',
    invalid='Orden de construcción no válida.',
    busy='Demasiadas órdenes seguidas. Espera un segundo.',
    valid='Posición válida · las cintas se unen por el centro y doblan solas.',
}
local function integer(v)
    return type(v)=='number' and v==v and math.abs(v)&lt;1e6 and v%1==0
end
function Construction.newState(ownerId)
    return {ownerId=ownerId,nextId=1,buildings={}}
end
function Construction.count(state)
    local n=0
    for _ in pairs(state.buildings) do n+=1 end
    return n
end
function Construction.snapshot(state)
    local result={}
    for _,rec in pairs(state.buildings) do table.insert(result,table.clone(rec)) end
    table.sort(result,function(a,b) return a.id&lt;b.id end)
    return {ownerId=state.ownerId,nextId=state.nextId,buildings=result}
end
function Construction.fromSnapshot(snapshot)
    local state=Construction.newState(snapshot.ownerId)
    state.nextId=snapshot.nextId
    for _,rec in ipairs(snapshot.buildings) do state.buildings[rec.id]=table.clone(rec) end
    return state
end
function Construction.rotate(v) return (v+1)%4 end
function Construction.worldToCell(x,z,ox,oz)
    return math.floor((x-ox)/Construction.CELL_SIZE),math.floor((z-oz)/Construction.CELL_SIZE)
end
function Construction.canPlace(state,typ,x,z,rotation,ignoreId,level)
    local data=Catalog.types[typ]
    if not data or not integer(rotation)
        or rotation&lt;0 or rotation&gt;3 then return false,'invalid' end
    local size=data.size
    level=level or 0
    if not integer(level) or level&lt;0 or level&gt;1 then return false,'invalid' end
    if (size==2 or Catalog.isElevator(typ)) and level~=0 then return false,'invalid' end
    local function half(v) return type(v)=='number' and v==v and math.abs(v)&lt;1e6 and (v*2)%1==0 end
    if data.size==1 then
        if not half(x) or not half(z) then return false,'invalid' end
    elseif not integer(x) or not integer(z) then return false,'invalid' end
    if x&lt;0 or z&lt;0 or x+size&gt;Construction.GRID_SIZE or z+size&gt;Construction.GRID_SIZE then return false,'outside' end
    for id,record in pairs(state.buildings) do
        if id~=ignoreId then
            local s=Catalog.types[record.machineType].size
            local otherLevel=record.level or 0
            local layersOverlap=level==otherLevel or Catalog.isElevator(typ) or Catalog.isElevator(record.machineType)
            if layersOverlap and x&lt;record.x+s and x+size&gt;record.x and z&lt;record.z+s and z+size&gt;record.z then
                return false,'occupied'
            end
        end
    end
    if not ignoreId and Construction.count(state)&gt;=Construction.MAX_MACHINES then return false,'limit' end
    return true,'valid'
end
function Construction.apply(state,actorId,order)
    if state.ownerId~=actorId then return false,'not_owner' end
    if type(order)~='table' then return false,'invalid' end
    local kind=order.kind
    if kind=='configure_filter' then
        if not integer(order.id) then return false,'invalid' end
        local rec=state.buildings[order.id]
        if not rec then return false,'not_found' end
        if not Catalog.isFilter(rec.machineType) or not Catalog.items[order.item] then return false,'invalid' end
        rec.filterItem=order.item
        return true,'configured',rec.id
    end
    if kind=='configure_recipe' then
        if not integer(order.id) or type(order.recipeId)~='string' then return false,'invalid' end
        local rec=state.buildings[order.id]
        if not rec then return false,'not_found' end
        local recipes=Catalog.recipeOrder[rec.machineType]
        if not recipes or not table.find(recipes,order.recipeId) then return false,'invalid' end
        rec.recipeId=order.recipeId
        return true,'configured_recipe',rec.id
    end
    if kind=='remove_many' then
        -- Validación completa ANTES de retirar cualquier estructura.
        -- Un comando admite como máximo el número de máquinas del terreno.
        local ids=order.ids
        if type(ids)~='table' or #ids&lt;1 or #ids&gt;Construction.MAX_MACHINES then
            return false,'invalid'
        end
        local seen={}
        for _,id in ipairs(ids) do
            if not integer(id) or id&lt;1 or seen[id] then return false,'invalid' end
            if not state.buildings[id] then return false,'not_found' end
            seen[id]=true
        end
        for _,id in ipairs(ids) do state.buildings[id]=nil end
        return true,'removed_many',ids
    end
    if kind~='place' and kind~='move' and kind~='remove' then return false,'invalid' end
    local old
    if kind~='place' then
        if not integer(order.id) or order.id&lt;1 then return false,'invalid' end
        old=state.buildings[order.id]
        if not old then return false,'not_found' end
    elseif type(order.machineType)~='string' or not Catalog.types[order.machineType] then return false,'invalid' end
    if kind=='remove' then
        state.buildings[order.id]=nil
        return true,'removed',order.id
    end
    local typ=if old then old.machineType else order.machineType
    local level=if old and order.level==nil then old.level or 0 else order.level or 0
    local good,code=Construction.canPlace(state,typ,order.x,order.z,order.rotation,if old then order.id else nil,level)
    if not good then return false,code end
    local id=if old then order.id else state.nextId
    state.buildings[id]={id=id,machineType=typ,x=order.x,z=order.z,rotation=order.rotation,level=level,filterItem=if old then old.filterItem else (if Catalog.isFilter(typ) then 'Carbon' else nil),
        recipeId=if old then old.recipeId else Catalog.recipeId(typ)}
    if not old then state.nextId+=1 end
    return true,if old then 'moved' else 'placed',id
end
function Construction.applyMany(state,actorId,orders)
    if state.ownerId~=actorId then return false,'not_owner' end
    if type(orders)~='table' or #orders&lt;1 or #orders&gt;64 then return false,'invalid' end
    local staged=Construction.fromSnapshot(Construction.snapshot(state))
    local ids={}
    for i,placement in ipairs(orders) do
        if type(placement)~='table' or placement.machineType~='Belt' then return false,'invalid' end
        local success,code,id=Construction.apply(staged,actorId,{
            kind='place',machineType='Belt',x=placement.x,z=placement.z,rotation=placement.rotation,level=placement.level or 0
        })
        if not success then return false,code end
        ids[i]=id
    end
    -- Operación atómica: ningún cambio real ocurre antes de validar la lista.
    state.nextId=staged.nextId
    state.buildings=staged.buildings
    return true,'placed_many',ids
end
function Construction.nextTarget(state,source)
    for _,target in pairs(state.buildings) do
        if source.id~=target.id and Catalog.connected(source,target) then return target end
    end
    return nil
end
return table.freeze(Construction)
