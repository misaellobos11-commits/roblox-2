BuildServer.start()
</ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null /></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{40A56D4E-E768-4F3C-BC14-47739CD606F5}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Server</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">558304b3c8ae25c20aedcdde000003e4</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="7">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict
-- Parcela elegida por jugador y validada en servidor; construcción de la etapa 1 intacta.
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Shared = ReplicatedStorage:WaitForChild('Shared')
local Construction = require(Shared.Construction)
local Catalog = require(Shared.MachineCatalog)
local MapConfig = require(Shared.MapConfig)
local Visual = require(Shared.MachineVisual)
local MapGenerator = require(script.Parent.MapGenerator)
local Simulation = require(script.Parent.FactorySimulation)
local Economy = require(Shared.Economy)
local BuildServer = {}

local CYAN = Color3.fromRGB(65,205,216)
local FREE = Color3.fromRGB(132,234,205)
local TAKEN = Color3.fromRGB(225,159,123)

local function slab(parent,name,size,position,color,material)
    local p=Instance.new('Part')
    p.Name=name
    p.Anchored=true
    p.Size=size
    p.Position=position
    p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.TopSurface=Enum.SurfaceType.Smooth
    p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end

local function addEdge(parent,size,at)
    local p=slab(parent,'BordeCian',size,at,CYAN,Enum.Material.Neon)
    p.CanCollide=false
    p.CanQuery=false
    p.CanTouch=false
end

local function createVacantPlot(parent,slot)
    local origin=MapConfig.plotOrigin(slot)
    local width=Construction.GRID_SIZE*Construction.CELL_SIZE
    local plot=Instance.new('Model')
    plot.Name='PlotSlot_'..slot
    plot:SetAttribute('Slot',slot)
    plot:SetAttribute('OwnerUserId',0)
    plot.Parent=parent
    local floor=slab(plot,'BuildFloor',Vector3.new(width,1,width),origin+Vector3.new(width/2,-.5,width/2),Color3.fromRGB(102,112,119),Enum.Material.Concrete)
    floor:SetAttribute('OwnerUserId',0)
    local grid=Instance.new('Folder')
    grid.Name='Grid'
    grid.Parent=plot
    for i=0,Construction.GRID_SIZE do
        local c=i*Construction.CELL_SIZE
        local col=if i%4==0 then Color3.fromRGB(130,146,149) else Color3.fromRGB(115,126,132)
        for _,line in {
            slab(grid,'Linea',Vector3.new(.045,.014,width),origin+Vector3.new(c,.014,width/2),col),
            slab(grid,'Linea',Vector3.new(width,.014,.045),origin+Vector3.new(width/2,.014,c),col),
        } do
            line.CanCollide=false
            line.CanTouch=false
            line.CanQuery=false
        end
    end
    addEdge(plot,Vector3.new(width,.18,.55),origin+Vector3.new(width/2,.1,0))
    addEdge(plot,Vector3.new(width,.18,.55),origin+Vector3.new(width/2,.1,width))
    addEdge(plot,Vector3.new(.55,.18,width),origin+Vector3.new(0,.1,width/2))
    addEdge(plot,Vector3.new(.55,.18,width),origin+Vector3.new(width,.1,width/2))
    local entrance=MapConfig.entryPoint(slot)
    slab(plot,'Entrada',Vector3.new(28,1,24),entrance+Vector3.new(0,-.5,0),Color3.fromRGB(64,77,84),Enum.Material.Concrete)
    local spawn=slab(plot,'EntrySpawn',Vector3.new(4,.2,4),entrance+Vector3.new(0,.5,0),CYAN,Enum.Material.Neon)
    spawn.CanCollide=false
    spawn.Transparency=1
    spawn.CanQuery=false
    local signPost=slab(plot,'PosteCartel',Vector3.new(2,8,2),entrance+Vector3.new(18,3,0),Color3.fromRGB(31,46,53),Enum.Material.Metal)
    local sign=Instance.new('BillboardGui')
    sign.Name='CartelParcela'
    sign.AlwaysOnTop=true
    sign.Size=UDim2.fromOffset(240,78)
    sign.StudsOffsetWorldSpace=Vector3.new(0,6.5,0)
    sign.MaxDistance=160
    sign.Parent=signPost
    local label=Instance.new('TextLabel')
    label.Name='Estado'
    label.Size=UDim2.fromScale(1,1)
    label.BackgroundColor3=Color3.fromRGB(26,39,49)
    label.BackgroundTransparency=.05
    label.TextColor3=FREE
    label.TextSize=18
    label.Font=Enum.Font.GothamBold
    label.Text=string.format('PARCELA %02d\nLIBRE',slot)
    label.Parent=sign
    local rounded=Instance.new('UICorner')
    rounded.CornerRadius=UDim.new(0,8)
    rounded.Parent=label
    local machines=Instance.new('Folder')
    machines.Name='Machines'
    machines.Parent=plot
    return {slot=slot,origin=origin,model=plot,spawn=spawn,sign=label,machines=machines}
end

local function redrawBelts(session)
    for id,record in pairs(session.state.buildings) do
        if record.machineType=='Belt' then
            local model=session.models[id]
            if model then
                Visual.setBeltIncoming(model,Catalog.beltIncoming(session.state.buildings,record))
            end
        end
    end
end

local function setPlotOwner(info,player)
    local ownerId=if player then player.UserId else 0
    info.model.Name=if player then 'Plot_'..ownerId else 'PlotSlot_'..info.slot
    info.model:SetAttribute('OwnerUserId',ownerId)
    local floor=info.model:FindFirstChild('BuildFloor')
    if floor then floor:SetAttribute('OwnerUserId',ownerId) end
    info.sign.Text=if player then string.format('PARCELA %02d\n%s',info.slot,player.DisplayName) else string.format('PARCELA %02d\nLIBRE',info.slot)
    info.sign.TextColor3=if player then TAKEN else FREE
end

function BuildServer.start()
    local lobbySpawn=MapGenerator.build()
    local folder=Instance.new('Folder')
    folder.Name='MatterloomPlots'
    folder.Parent=workspace
    local plotInfo={}
    for slot=1,Construction.MAX_PLOTS do
        plotInfo[slot]=createVacantPlot(folder,slot)
    end
    local remotes=Instance.new('Folder')
    remotes.Name='Matterloom'
    local function remote(kind,name)
        local object=Instance.new(kind)
        object.Name=name
        object.Parent=remotes
        return object
    end
    local getState=remote('RemoteFunction','GetState')
    local command=remote('RemoteEvent','Command')
    local getPlots=remote('RemoteFunction','GetPlots')
    local claimPlot=remote('RemoteFunction','ClaimPlot')
    local changed=remote('RemoteEvent','PlotsChanged')
    local factoryUpdate=remote('RemoteEvent','FactoryState')
    local sessions,slots={},{}

    local function availablePlots()
        local list={}
        for n=1,Construction.MAX_PLOTS do
            local owner=slots[n]
            list[n]={slot=n,occupied=owner~=nil,ownerName=if owner then owner.DisplayName else ''}
        end
        return list
    end
    local function packet(session)
        return {state=Construction.snapshot(session.state),origin=session.origin,slot=session.slot,factory=Simulation.report(session)}
    end
    local function moveCharacter(player,character,session)
        local root=character:WaitForChild('HumanoidRootPart',10)
        if not root or player.Character~=character then return end
        if sessions[player]==session then
            character:PivotTo(CFrame.new(session.spawn.Position+Vector3.new(0,4,0)) * CFrame.Angles(0,math.pi,0))
        end
    end
    getPlots.OnServerInvoke=function(player)
        return {slots=availablePlots(),ownedSlot=if sessions[player] then sessions[player].slot else nil}
    end
    claimPlot.OnServerInvoke=function(player,requestedSlot)
        if sessions[player] then
            return {ok=true,slot=sessions[player].slot,packet=packet(sessions[player])}
        end
        if type(requestedSlot)~='number' or requestedSlot%1~=0 or requestedSlot&lt;1 or requestedSlot&gt;Construction.MAX_PLOTS then
            return {ok=false,error='La parcela indicada no existe.',slots=availablePlots()}
        end
        if slots[requestedSlot] then
            return {ok=false,error='Esta parcela ya está ocupada. Elige otra.',slots=availablePlots()}
        end
        -- Reservar ANTES de cualquier operación que pueda ceder ejecución.
        slots[requestedSlot]=player
        local info=plotInfo[requestedSlot]
        setPlotOwner(info,player)
        local session={
            state=Construction.newState(player.UserId),origin=info.origin,model=info.model,
            machines=info.machines,models={},slot=requestedSlot,spawn=info.spawn,
            tokens=12,lastRequest=os.clock()
        }
        Simulation.newSession(session)
        sessions[player]=session
        if player.Character then task.spawn(moveCharacter,player,player.Character,session) end
        changed:FireAllClients(availablePlots())
        return {ok=true,slot=requestedSlot,packet=packet(session)}
    end
    getState.OnServerInvoke=function(player)
        local session=sessions[player]
        if not session then return {error='Debes elegir primero una parcela.'} end
        return packet(session)
    end
    command.OnServerEvent:Connect(function(player,order)
        local session=sessions[player]
        if not session or type(order)~='table' then return end
        local now=os.clock()
        session.tokens=math.min(12,session.tokens+(now-session.lastRequest)*6)
        session.lastRequest=now
        if session.tokens&lt;1 then
            if not session.lastBusy or now-session.lastBusy&gt;=1 then
                session.lastBusy=now
                command:FireClient(player,{ok=false,code='busy'})
            end
            return
        end
        session.tokens-=1
        -- Matterloom 8.3: demos de prueba habilitadas de nuevo.
        -- Se usan para ensayar conexiones y recetas sin gastar creditos;
        -- el catalogo de compras mantiene la progresion normal.
        -- Laboratorio de logística reproducible: 8 circuitos, 10 piezas de transporte.
        -- Construcción en dos fases (simulación + commit) para evitar medias demos.
        if order.kind=='demo' then
    local demo={
        {t='Receiver',x=7,z=2,r=0,level=0},
