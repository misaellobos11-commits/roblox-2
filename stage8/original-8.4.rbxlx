				<Item class="ModuleScript" referent="1003">
					<Properties>
						<Content name="LinkedSource"><null /></Content>
						<ProtectedString name="Source">--!nonstrict
-- Selector estilo tycoon: cámara sobre parcela, flechas y botón de reclamar.
local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local TweenService=game:GetService('TweenService')
local UserInputService=game:GetService('UserInputService')
local MapConfig=require(ReplicatedStorage:WaitForChild('Shared'):WaitForChild('MapConfig'))
local PlotSelector={}
local BLACK=Color3.fromRGB(15,26,36)
local CYAN=Color3.fromRGB(83,222,225)
local TEXT=Color3.fromRGB(235,242,247)
local MUTED=Color3.fromRGB(163,183,194)

local function rounded(frame,r)
    local corner=Instance.new('UICorner')
    corner.CornerRadius=UDim.new(0,r)
    corner.Parent=frame
end
local function label(parent,name,value,size,position,dimensions,color)
    local result=Instance.new('TextLabel')
    result.Name=name
    result.Position=position
    result.Size=dimensions
    result.BackgroundTransparency=1
    result.Font=Enum.Font.GothamBold
    result.Text=value
    result.TextScaled=false
    result.TextSize=size
    result.TextColor3=color or TEXT
    result.Parent=parent
    return result
end
local function button(parent,name,value,position,dimensions)
    local result=Instance.new('TextButton')
    result.Name=name
    result.Position=position
    result.Size=dimensions
    result.BackgroundColor3=BLACK
    result.BackgroundTransparency=.06
    result.BorderSizePixel=0
    result.AutoButtonColor=true
    result.Font=Enum.Font.GothamBold
    result.Text=value
    result.TextSize=22
    result.TextColor3=TEXT
    result.Parent=parent
    rounded(result,10)
    return result
end

function PlotSelector.start(onSelected)
    local player=Players.LocalPlayer
    local remotes=ReplicatedStorage:WaitForChild('Matterloom')
    local getPlots=remotes:WaitForChild('GetPlots')
    local claimPlot=remotes:WaitForChild('ClaimPlot')
    local changed=remotes:WaitForChild('PlotsChanged')
    local cam=workspace.CurrentCamera
    while not cam do
        workspace:GetPropertyChangedSignal('CurrentCamera'):Wait()
        cam=workspace.CurrentCamera
    end
    local gui=Instance.new('ScreenGui')
    gui.Name='MatterloomSeleccionParcela'
    gui.ResetOnSpawn=false
    gui.IgnoreGuiInset=true
    gui.DisplayOrder=80
    gui.Parent=player:WaitForChild('PlayerGui')
    local top=Instance.new('Frame')
    top.Name='PanelSuperior'
    top.AnchorPoint=Vector2.new(.5,0)
    top.Position=UDim2.new(.5,0,0,35)
    top.Size=UDim2.new(.8,0,0,100)
    top.BackgroundColor3=BLACK
    top.BackgroundTransparency=.09
    top.Parent=gui
    rounded(top,12)
    local maxSize=Instance.new('UISizeConstraint')
    maxSize.MaxSize=Vector2.new(520,100)
    maxSize.Parent=top
    local title=label(top,'Titulo','MATTERLOOM  /  ELIGE TU PARCELA',19,UDim2.fromOffset(18,12),UDim2.new(1,-36,0,30),CYAN)
    title.TextXAlignment=Enum.TextXAlignment.Center
    local status=label(top,'Estado','Cargando parcelas…',16,UDim2.new(0,12,0,50),UDim2.new(1,-24,0,35),TEXT)
    status.TextXAlignment=Enum.TextXAlignment.Center
    local navigation=Instance.new('Frame')
    navigation.Name='Navegacion'
    navigation.AnchorPoint=Vector2.new(.5,1)
    navigation.Position=UDim2.new(.5,0,1,-35)
    navigation.Size=UDim2.new(.92,0,0,72)
    navigation.BackgroundTransparency=1
    navigation.Parent=gui
    local navSize=Instance.new('UISizeConstraint')
    navSize.MaxSize=Vector2.new(620,72)
    navSize.Parent=navigation
    local left=button(navigation,'Anterior','◀',UDim2.fromScale(0,0),UDim2.fromScale(.18,1))
    local choose=button(navigation,'Elegir','ELEGIR PARCELA',UDim2.fromScale(.20,0),UDim2.fromScale(.60,1))
    local right=button(navigation,'Siguiente','▶',UDim2.fromScale(.82,0),UDim2.fromScale(.18,1))
    choose.BackgroundColor3=Color3.fromRGB(24,114,120)
    local helper=label(gui,'Indicacion','Usa ◀ y ▶ para explorar las ocho parcelas',14,UDim2.new(.5,-200,1,-112),UDim2.fromOffset(400,30),MUTED)
    helper.TextXAlignment=Enum.TextXAlignment.Center
    local index=1
    local plots={}
    local pending=false
    local alive=true
    local currentTween=nil

    local function focus()
        local center=MapConfig.plotCenter(index)
        local toward=if index&lt;=4 then 1 else -1
        local eye=center+Vector3.new(92,108,112*toward)
        cam.CameraType=Enum.CameraType.Scriptable
        if currentTween then currentTween:Cancel() end
        currentTween=TweenService:Create(cam,TweenInfo.new(.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
            CFrame=CFrame.lookAt(eye,center),Focus=CFrame.new(center)
        })
        currentTween:Play()
    end
    local function render()
        local item=plots[index]
        if not item then
            status.Text='Cargando…'
            choose.Active=false
            return
        end
        if item.occupied then
            status.Text=string.format('PARCELA %02d  ·  OCUPADA POR %s',index,item.ownerName)
            status.TextColor3=Color3.fromRGB(255,175,146)
            choose.Text='OCUPADA'
            choose.Active=false
            choose.BackgroundColor3=Color3.fromRGB(70,70,75)
        else
            status.Text=string.format('PARCELA %02d  ·  DISPONIBLE',index)
            status.TextColor3=Color3.fromRGB(140,243,207)
            choose.Text='ELEGIR PARCELA'
            choose.Active=not pending
            choose.BackgroundColor3=Color3.fromRGB(24,114,120)
        end
    end
    local function navigate(direction)
        if pending then return end
        index=((index-1+direction) % MapConfig.MAX_PLOTS)+1
        render()
        focus()
    end
    left.MouseButton1Click:Connect(function() navigate(-1) end)
    right.MouseButton1Click:Connect(function() navigate(1) end)
    local changedConnection=changed.OnClientEvent:Connect(function(latest)
        if not alive then return end
        plots=latest
        render()
    end)
    local inputConnection=UserInputService.InputBegan:Connect(function(input,processed)
        if processed or not alive then return end
        if input.KeyCode==Enum.KeyCode.Left or input.KeyCode==Enum.KeyCode.A then navigate(-1)
        elseif input.KeyCode==Enum.KeyCode.Right or input.KeyCode==Enum.KeyCode.D then navigate(1) end
    end)
    choose.MouseButton1Click:Connect(function()
        if pending or not plots[index] or plots[index].occupied then return end
        pending=true
        choose.Text='RESERVANDO…'
        choose.Active=false
        local ok,result=pcall(function() return claimPlot:InvokeServer(index) end)
        if not ok or not result then
            status.Text='No se pudo conectar. Intenta otra vez.'
            pending=false
            render()
            return
        end
        if not result.ok then
            if result.slots then plots=result.slots end
            pending=false
            render()
            status.Text=result.error or 'No se pudo elegir esta parcela.'
            return
        end
        alive=false
        changedConnection:Disconnect()
        inputConnection:Disconnect()
        if currentTween then currentTween:Cancel() end
        gui:Destroy()
        cam.CameraType=Enum.CameraType.Custom
        local character=player.Character
        local humanoid=character and character:FindFirstChildOfClass('Humanoid')
        if humanoid then cam.CameraSubject=humanoid end
        onSelected(result.packet)
    end)
    local success,initial=pcall(function() return getPlots:InvokeServer() end)
    if success and initial and initial.slots then
        plots=initial.slots
        if initial.ownedSlot then index=initial.ownedSlot end
    else
        status.Text='Error de conexión con el servidor.'
    end
    render()
    focus()
end

return PlotSelector
